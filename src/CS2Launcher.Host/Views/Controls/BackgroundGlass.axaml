<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:CS2Launcher.Host.Views.Controls" x:Class="CS2Launcher.Host.Views.Controls.BackgroundGlass" x:Name="GlassRoot" x:DataType="local:BackgroundGlass" IsHitTestVisible="False" ClipToBounds="True">
  <Grid>
    <!-- Sample the complete, aligned background, then clip to this surface.
         The source never contains this glass or foreground controls. -->
    <Canvas>
      <Rectangle x:Name="BlurredSurface" Width="{Binding #GlassRoot.Source.Bounds.Width}" Height="{Binding #GlassRoot.Source.Bounds.Height}" Canvas.Top="{Binding #GlassRoot.OffsetY}">
        <Rectangle.Fill>
          <VisualBrush Visual="{Binding #GlassRoot.Source}" Stretch="Fill"/>
        </Rectangle.Fill>
      </Rectangle>
    </Canvas>
    <Border Background="{DynamicResource SidebarBackground}" Opacity="{Binding #GlassRoot.TintOpacity}"/>
  </Grid>
</UserControl>
