<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:CS2Launcher.Host.ViewModels" xmlns:arc="https://github.com/AIDotNet/TKCode.Arc" x:Class="CS2Launcher.Host.Views.Pages.InstancesPage" x:DataType="vm:ShellViewModel">
  <ScrollViewer>
    <StackPanel Margin="36" Spacing="22">
      <TextBlock Classes="heading" Text="实例列表"/>
      <TextBlock Classes="muted" Text="一套配置，一种玩法。所有实例共用全局最新服务端。"/>
      <Border Classes="panel">
        <StackPanel Spacing="12">
          <TextBlock Classes="subheading" Text="尚无服务器实例"/>
          <TextBlock Classes="muted" Text="创建实例后，可分别管理插件、地图、启动设置与玩家授权。"/>
          <StackPanel Orientation="Horizontal" Spacing="12">
            <arc:Button Content="＋ 创建实例" IsEnabled="False" HorizontalAlignment="Left" Variant="Secondary"/>
            <arc:Button Content="导入实例配置" IsEnabled="False" HorizontalAlignment="Left" Variant="Secondary"/>
          </StackPanel>
        </StackPanel>
      </Border>
      <Border Classes="notice">
        <TextBlock Classes="muted" Text="创建与导入功能尚未接入，当前不会创建目录或写入配置。"/>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
