<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:CS2Launcher.Host.ViewModels" xmlns:arc="https://github.com/AIDotNet/TKCode.Arc" x:Class="CS2Launcher.Host.Views.Pages.InstancePage" x:DataType="vm:ShellViewModel">
  <ScrollViewer>
    <StackPanel Margin="36" Spacing="22">
      <TextBlock Classes="heading" Text="实例管理"/>
      <TextBlock Classes="muted" Text="配置与插件按实例隔离，服务端版本统一维护。"/>
      <Border Classes="panel">
        <StackPanel Spacing="12">
          <TextBlock Classes="subheading" Text="尚未选择实例"/>
          <TextBlock Classes="muted" Text="先从实例列表选择或创建一个实例。"/>
          <arc:Button Content="前往实例列表 →" Command="{Binding NavigateCommand}" CommandParameter="instances" HorizontalAlignment="Left" Variant="Secondary"/>
        </StackPanel>
      </Border>
      <Border Classes="panel">
        <StackPanel Spacing="12">
          <TextBlock Classes="subheading" Text="配置与 CFG"/>
          <TextBlock Classes="muted" Text="管理启动参数、游戏模式、地图与自定义 CFG。实例创建后开放编辑。"/>
        </StackPanel>
      </Border>
      <Border Classes="panel">
        <StackPanel Spacing="12">
          <TextBlock Classes="subheading" Text="插件与方案"/>
          <TextBlock Classes="muted" Text="管理插件依赖、版本及配置，一键切换独立玩法方案。"/>
        </StackPanel>
      </Border>
      <Border Classes="panel">
        <StackPanel Spacing="12">
          <TextBlock Classes="subheading" Text="玩家授权"/>
          <TextBlock Classes="muted" Text="参赛与管理员权限分别授予；未经参赛授权的玩家仅可旁观。"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
