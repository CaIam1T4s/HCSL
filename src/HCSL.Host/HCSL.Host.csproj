<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- AVLN3001: the console window is only ever created with its controller and owner, so it has no
         parameterless constructor for the runtime XAML loader. Its XAML is compiled, never loaded by name. -->
    <NoWarn>$(NoWarn);AVLN3001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.5" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.5" />
    <PackageReference Include="TKCode.Arc" Version="1.1.0" />
    <PackageReference Include="TKCode.Arc.Blocks" Version="1.1.0" />
    <PackageReference Include="TKCode.Arc.Special" Version="1.1.0" />
    <PackageReference Include="TKCode.Arc.Icons.Lucide" Version="1.1.0" />
    <PackageReference Include="TKCode.Spyglass.Agent" Version="0.2.3" Condition="'$(Configuration)' == 'Debug'" />
    <PackageReference Include="TKCode.Spyglass.HotReload" Version="0.2.3" Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>
  <ItemGroup><ProjectReference Include="../HCSL.Infrastructure/HCSL.Infrastructure.csproj" /><ProjectReference Include="../HCSL.Frontend/HCSL.Frontend.csproj" /><ProjectReference Include="../HCSL.UI.Shared/HCSL.UI.Shared.csproj" /></ItemGroup>
  <ItemGroup>
    <LucideIcon Include="PackageOpen;LoaderCircle;Rocket;CircleCheckBig;Clock;CircleAlert;TriangleAlert;Pause;ArrowLeft;RotateCw;Play;EllipsisVertical;ScrollText;Settings;PencilLine;Trash;FolderSync;Plus;ArrowUp;ArrowDown;Info;CircleSmall;Send" />
  </ItemGroup>
  <Import Project="../../build/DaemonPayload.targets" />
</Project>
