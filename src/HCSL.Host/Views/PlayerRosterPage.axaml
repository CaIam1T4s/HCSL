<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:lucide="using:TKCode.Arc.Icons.Lucide"
             xmlns:vm="using:HCSL.Host.ViewModels"
             x:Class="HCSL.Host.Views.PlayerRosterPage"
             Classes="player-roster-page">
  <UserControl.Resources>
    <!-- Row templates live on the columns; see arc:Table / arc:DataTableColumn in the Table page. -->
  </UserControl.Resources>

  <Panel>
    <!-- The window keeps its own gradient: this page only insets the roster frame. -->
    <Border Classes="console-page">
      <Border Classes="console-roster-frame">
        <Border Classes="console-roster-clip">
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <!-- Column bindings target row items, not this control's data context, so they stay reflection bindings;
                 the cell templates keep their compiled x:DataType. -->
            <arc:Table x:Name="Table" Classes="console-players" x:CompileBindings="False"
                       Caption="在线玩家" EmptyMessage="暂无玩家" LoadingMessage="正在读取玩家列表"
                       ItemNameOne="名玩家" ItemNameOther="名玩家"
                       HorizontalAlignment="Left" VerticalAlignment="Stretch">
              <arc:Table.Columns>
                <arc:DataTableColumn Header="玩家" Binding="{Binding Name}"
                                    Width="{DynamicResource ConsoleTablePlayerWidth}">
                  <arc:DataTableColumn.CellTemplate>
                    <DataTemplate x:DataType="vm:PlayerRow">
                      <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                    </DataTemplate>
                  </arc:DataTableColumn.CellTemplate>
                </arc:DataTableColumn>
                <arc:DataTableColumn Header="身份" Binding="{Binding Identity}"
                                    Width="{DynamicResource ConsoleTableIdentityWidth}">
                  <arc:DataTableColumn.CellTemplate>
                    <DataTemplate x:DataType="vm:PlayerRow">
                      <arc:Badge Size="Small" Tone="{Binding IdentityTone}" Content="{Binding Identity}"
                                 arc:Tooltip.Tip="{Binding IdentityTooltip}"
                                 HorizontalAlignment="Left" VerticalAlignment="Center">
                        <arc:Badge.Icon>
                          <lucide:LucideIcon Kind="{Binding IdentityIcon}"/>
                        </arc:Badge.Icon>
                      </arc:Badge>
                    </DataTemplate>
                  </arc:DataTableColumn.CellTemplate>
                </arc:DataTableColumn>
                <arc:DataTableColumn Header="SteamID" Binding="{Binding SteamIdText}"
                                    Width="{DynamicResource ConsoleTableSteamIdWidth}">
                  <arc:DataTableColumn.CellTemplate>
                    <DataTemplate x:DataType="vm:PlayerRow">
                      <TextBlock Text="{Binding SteamIdText}" VerticalAlignment="Center"/>
                    </DataTemplate>
                  </arc:DataTableColumn.CellTemplate>
                </arc:DataTableColumn>
                <arc:DataTableColumn Header="地址" Binding="{Binding Address}"
                                    Width="{DynamicResource ConsoleTableAddressWidth}">
                  <arc:DataTableColumn.CellTemplate>
                    <DataTemplate x:DataType="vm:PlayerRow">
                      <TextBlock Text="{Binding Address}" VerticalAlignment="Center"/>
                    </DataTemplate>
                  </arc:DataTableColumn.CellTemplate>
                </arc:DataTableColumn>
                <arc:DataTableColumn Header="状态" Binding="{Binding State}"
                                    Width="{DynamicResource ConsoleTableStateWidth}">
                  <arc:DataTableColumn.CellTemplate>
                    <DataTemplate x:DataType="vm:PlayerRow">
                      <arc:Badge Size="Small" Tone="{Binding StateTone}" Content="{Binding State}"
                                 HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    </DataTemplate>
                  </arc:DataTableColumn.CellTemplate>
                </arc:DataTableColumn>
                <!-- Numeric value for the sort, text for display: IsNumeric stays off so header and cells left-align. -->
                <arc:DataTableColumn Header="延迟" Binding="{Binding PingText}" SortBinding="{Binding Ping}"
                                    IsNumeric="False"
                                    Width="{DynamicResource ConsoleTablePingWidth}">
                  <arc:DataTableColumn.CellTemplate>
                    <DataTemplate x:DataType="vm:PlayerRow">
                      <TextBlock Text="{Binding PingText}" VerticalAlignment="Center"/>
                    </DataTemplate>
                  </arc:DataTableColumn.CellTemplate>
                </arc:DataTableColumn>
                <arc:DataTableColumn Header="在线时长" Binding="{Binding Connected}"
                                    Width="{DynamicResource ConsoleTableConnectedWidth}">
                  <arc:DataTableColumn.CellTemplate>
                    <DataTemplate x:DataType="vm:PlayerRow">
                      <TextBlock Text="{Binding Connected}" VerticalAlignment="Center"/>
                    </DataTemplate>
                  </arc:DataTableColumn.CellTemplate>
                </arc:DataTableColumn>
              </arc:Table.Columns>
            </arc:Table>
          </ScrollViewer>
        </Border>
      </Border>
    </Border>

    <!-- Row confirmations open at the context menu's own origin, exactly like the instance list. -->
    <Canvas x:Name="AnchorLayer" IsHitTestVisible="False">
      <Border x:Name="Anchor" Classes="popover-anchor"/>
    </Canvas>
    <arc:Popover x:Name="HoldPopover" Placement="Bottom" Alignment="Start" Offset="0"
                 TriggerMode="Manual" HasShadow="False">
      <arc:Popover.Styles>
        <Style Selector="arc|PopoverSurface">
          <Setter Property="Background" Value="Transparent"/>
          <Setter Property="BorderThickness" Value="0"/>
          <Setter Property="Padding" Value="0"/>
        </Style>
      </arc:Popover.Styles>
      <arc:HoldToConfirm x:Name="HoldAction" HoldDuration="0:0:1" Tone="Danger"/>
    </arc:Popover>

    <arc:Dialog x:Name="GrantDialog" Title="授予管理员" Size="Small" ShowCloseButton="True">
      <!-- The player is the dialog's description and the group is a labelled field, so the body carries no
           hand-written prompt line (see the Dialog and Select pages). -->
      <StackPanel Classes="roster-grant-body">
        <arc:Select x:Name="GrantGroup" Label="管理组" Placeholder="选择管理组"
                    SelectionChanged="OnGrantGroupChanged"/>
      </StackPanel>
      <arc:Dialog.Actions>
        <StackPanel Orientation="Horizontal" Spacing="{arc:ArcDesignTokenResource Space2}"
                    HorizontalAlignment="Right" Classes="dialog-actions">
          <arc:Button Content="取消" Variant="Secondary" Click="CloseGrant"/>
          <arc:Button x:Name="GrantConfirm" Content="授予管理员" Classes="dialog-primary"
                      Click="ConfirmGrant" IsDefault="True" IsEnabled="False"/>
        </StackPanel>
      </arc:Dialog.Actions>
    </arc:Dialog>
  </Panel>
</UserControl>
