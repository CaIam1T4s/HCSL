<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:HCSL.Host.ViewModels" xmlns:controls="using:HCSL.Host.Views.Controls" xmlns:pages="using:HCSL.Host.Views.Pages" xmlns:arc="https://github.com/AIDotNet/TKCode.Arc" x:Class="HCSL.Host.Views.MainWindow" x:DataType="vm:ShellViewModel" Title="HCSL · 服主管理端" Width="1280" Height="800" MinWidth="1024" MinHeight="680" Background="{DynamicResource ShellBackground}" WindowDecorations="BorderOnly">
  <Grid>
    <controls:BackgroundScene x:Name="BackgroundLayer" Strength="{Binding BackgroundOpacity}"/>
    <Grid RowDefinitions="44,*">
      <Border Classes="titlebar">
        <Grid ColumnDefinitions="*,Auto">
          <Border Background="Transparent" PointerPressed="DragTitleBar" Padding="16,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <Path Data="{x:Static arc:ArcIcons.Server}" Classes="glyph"/>
              <TextBlock Text="HCSL · 服主管理端" VerticalAlignment="Center" FontSize="13"/>
            </StackPanel>
          </Border>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="0,4,8,4">
            <arc:Button Classes="caption" Variant="Secondary" Click="MinimizeWindow" ToolTip.Tip="最小化" AutomationProperties.Name="最小化">
              <Path Data="{x:Static arc:ArcIcons.Minus}" Classes="glyph"/>
            </arc:Button>
            <arc:Button Classes="caption" Variant="Secondary" Click="ToggleMaximizeWindow" ToolTip.Tip="最大化或还原" AutomationProperties.Name="最大化或还原">
              <Path x:Name="MaximizeGlyph" Data="{x:Static arc:ArcIcons.Square}" Classes="glyph"/>
            </arc:Button>
            <arc:Button Classes="caption close" Variant="Secondary" Click="CloseWindow" ToolTip.Tip="关闭" AutomationProperties.Name="关闭">
              <Path Data="{x:Static arc:ArcIcons.X}" Classes="glyph"/>
            </arc:Button>
          </StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Row="1" ColumnDefinitions="216,*">
        <Grid>
          <controls:BackgroundGlass Source="{Binding #BackgroundLayer}" OffsetY="-44" BlurRadius="{Binding SidebarBlurRadius}" TintOpacity="{Binding SidebarTintOpacity}"/>
          <Border Classes="sidebar">
            <Grid Margin="12,8,12,16" RowDefinitions="Auto,*,Auto">
              <StackPanel Spacing="10">
                <TextBlock Text="账号" Classes="section"/>
                <Grid ColumnDefinitions="42,*" Margin="10,0,0,10">
                  <Border Classes="avatar">
                    <TextBlock Text="CS" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="3">
                    <TextBlock Text="未登录 Steam" FontWeight="SemiBold"/>
                    <TextBlock Text="账号服务待接入" Classes="muted" FontSize="11"/>
                  </StackPanel>
                </Grid>
              </StackPanel>
              <ScrollViewer Grid.Row="1">
                <StackPanel Spacing="3">
                  <TextBlock Text="服务器" Classes="section"/>
                  <arc:Button Classes="nav" Classes.selected="{Binding Pages[0].IsSelected}" Variant="Secondary" Command="{Binding NavigateCommand}" CommandParameter="home">
                    <Grid ColumnDefinitions="28,*">
                      <Path Data="{x:Static arc:ArcIcons.House}" Classes="glyph" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="1" Text="首页" VerticalAlignment="Center"/>
                    </Grid>
                  </arc:Button>
                  <arc:Button Classes="nav" Classes.selected="{Binding Pages[1].IsSelected}" Variant="Secondary" Command="{Binding NavigateCommand}" CommandParameter="instance">
                    <Grid ColumnDefinitions="28,*">
                      <Path Data="{x:Static arc:ArcIcons.Server}" Classes="glyph" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="1" Text="实例管理" VerticalAlignment="Center"/>
                    </Grid>
                  </arc:Button>
                  <arc:Button Classes="nav" Classes.selected="{Binding Pages[2].IsSelected}" Variant="Secondary" Command="{Binding NavigateCommand}" CommandParameter="instances">
                    <Grid ColumnDefinitions="28,*">
                      <Path Data="{x:Static arc:ArcIcons.List}" Classes="glyph" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="1" Text="实例列表" VerticalAlignment="Center"/>
                    </Grid>
                  </arc:Button>
                  <arc:Button Classes="nav" Classes.selected="{Binding Pages[3].IsSelected}" Variant="Secondary" Command="{Binding NavigateCommand}" CommandParameter="downloads">
                    <Grid ColumnDefinitions="28,*">
                      <Path Data="{x:Static arc:ArcIcons.Download}" Classes="glyph" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="1" Text="下载中心" VerticalAlignment="Center"/>
                    </Grid>
                  </arc:Button>
                  <TextBlock Text="通用" Classes="section"/>
                  <arc:Button Classes="nav" Classes.selected="{Binding Pages[4].IsSelected}" Variant="Secondary" Command="{Binding NavigateCommand}" CommandParameter="network">
                    <Grid ColumnDefinitions="28,*">
                      <Path Data="{x:Static arc:ArcIcons.Layers}" Classes="glyph" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="1" Text="联机组网" VerticalAlignment="Center"/>
                    </Grid>
                  </arc:Button>
                  <arc:Button Classes="nav" Classes.selected="{Binding Pages[5].IsSelected}" Variant="Secondary" Command="{Binding NavigateCommand}" CommandParameter="settings">
                    <Grid ColumnDefinitions="28,*">
                      <Path Data="{x:Static arc:ArcIcons.Settings}" Classes="glyph" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="1" Text="设置" VerticalAlignment="Center"/>
                    </Grid>
                  </arc:Button>
                </StackPanel>
              </ScrollViewer>
              <TextBlock Grid.Row="2" Text="● 开发预览" Classes="muted" FontSize="11" Margin="12,16,0,0" ToolTip.Tip="界面骨架，服务器与网络服务尚未接入。"/>
            </Grid>
          </Border>
        </Grid>
        <Grid Grid.Column="1">
          <Grid IsVisible="{Binding IsHome}" Margin="32" RowDefinitions="*,Auto">
            <Border Grid.Row="1" HorizontalAlignment="Right" Width="290">
              <StackPanel Spacing="10">
                <arc:Button IsEnabled="False" Variant="Secondary" HorizontalAlignment="Right">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Path Data="{x:Static arc:ArcIcons.Shield}" Classes="glyph"/>
                    <TextBlock Text="VAC · 待配置"/>
                  </StackPanel>
                </arc:Button>
                <Border Classes="launch-shadow">
                  <arc:Button Classes="empty-launch" Variant="Secondary" Command="{Binding NavigateCommand}" CommandParameter="instances" ToolTip.Tip="前往实例列表；实例创建功能尚未接入。" AutomationProperties.Name="没有服务器实例，前往实例列表">
                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                      <TextBlock Text="没有服务器实例" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                      <TextBlock Text="前往实例列表" Classes="muted" FontSize="12" HorizontalAlignment="Center"/>
                    </StackPanel>
                  </arc:Button>
                </Border>
              </StackPanel>
            </Border>
          </Grid>
          <Border IsVisible="{Binding !IsHome}" Background="{DynamicResource ShellBackground}"/>
          <pages:InstancePage IsVisible="{Binding IsInstance}"/>
          <pages:InstancesPage IsVisible="{Binding IsInstances}"/>
          <pages:DownloadsPage IsVisible="{Binding IsDownloads}"/>
          <pages:NetworkPage IsVisible="{Binding IsNetwork}"/>
          <pages:SettingsPage IsVisible="{Binding IsSettings}"/>
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</Window>
