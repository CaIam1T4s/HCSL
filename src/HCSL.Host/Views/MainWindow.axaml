<arc:ArcWindow xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:HCSL.Host.ViewModels" xmlns:controls="using:HCSL.UI.Shared.Controls" xmlns:pages="using:HCSL.Host.Views.Pages" xmlns:lucide="using:TKCode.Arc.Icons.Lucide" xmlns:arc="https://github.com/AIDotNet/TKCode.Arc" x:Class="HCSL.Host.Views.MainWindow" x:Name="ShellWindowRoot" x:DataType="vm:ShellViewModel" Classes="wallpaper-shell" controls:WindowModalLayer.IsOpen="{Binding #DialogOverlay.IsVisible}" controls:WindowBackdrop.Strength="{Binding BackgroundOpacity}" Title="HCSL · 服主管理端" Width="1280" Height="800" MinWidth="1024" MinHeight="680" Background="{DynamicResource ShellBackground}">
  <arc:ArcWindow.TitleBar>
    <arc:TitleBar x:Name="ShellTitleBar" Height="44" CaptionButtons="Auto" Background="Transparent">
      <arc:TitleBar.LeftContent>
        <StackPanel Orientation="Horizontal" Spacing="{arc:ArcDesignTokenResource Space2}" VerticalAlignment="Center">
          <!-- The scope names itself in the title bar, the way the launcher's reference UI does: back arrow, then the
               page and instance, then the live status. -->
          <arc:Button x:Name="ScopeBackButton" Variant="Ghost" Size="Small" IsVisible="False"
                      Padding="0" Width="{arc:ArcDesignTokenResource Space6}"
                      Height="{arc:ArcDesignTokenResource Space6}" Click="LeaveInstanceScope">
            <lucide:LucideIcon Kind="ArrowLeft" Width="16" Height="16"/>
          </arc:Button>
          <TextBlock x:Name="ScopeTitleText" IsVisible="False" VerticalAlignment="Center"
                     FontSize="{arc:ArcDesignTokenResource TypeBase}"/>
          <arc:Badge x:Name="ServerStatusBadge" Size="Medium"/>
        </StackPanel>
      </arc:TitleBar.LeftContent>
      <arc:TitleBar.Icon>
        <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Server}" Size="16"/>
      </arc:TitleBar.Icon>
    </arc:TitleBar>
  </arc:ArcWindow.TitleBar>
  <Grid>
    <Grid x:Name="ShellContent" ColumnDefinitions="216,*">
      <Grid ZIndex="1">
          <Border Classes="sidebar">
            <Panel>
            <arc:Sidebar x:Name="MainSidebar" Classes="main-sidebar" BorderThickness="0" ExpandedWidth="216" IsCollapsed="False"
                         IsCollapseButtonVisible="False" IsFilterVisible="False" IsVisible="{Binding !IsInstance}"
                         Background="Transparent" Label="主导航"
                         SelectedKey="{Binding SelectedPage.Id, Mode=OneWay}" ItemInvoked="SidebarItemInvoked">
              <arc:Sidebar.Header>
              <StackPanel Spacing="10">
                <TextBlock Text="账号" Classes="section"/>
                <Grid ColumnDefinitions="42,*" Margin="10,0,0,10">
                  <Border Classes="avatar">
                    <TextBlock Text="CS" FontWeight="Bold" Foreground="{arc:ArcDesignTokenResource AccentStrong}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="3">
                    <TextBlock Text="未登录 Steam" FontWeight="SemiBold"/>
                    <TextBlock Text="账号服务待接入" Classes="muted" FontSize="{arc:ArcDesignTokenResource TypeXS}"/>
                  </StackPanel>
                </Grid>
              </StackPanel>
              </arc:Sidebar.Header>
              <arc:SidebarSection Header="服务器">
                <arc:SidebarItem Key="home" Label="首页" Icon="{x:Static arc:ArcIcons.House}"/>
                <arc:SidebarItem Key="instance" Label="实例管理" Icon="{x:Static arc:ArcIcons.Server}"/>
                <arc:SidebarItem Key="instances" Label="实例列表" Icon="{x:Static arc:ArcIcons.List}"/>
                <arc:SidebarItem Key="downloads" Label="下载中心" Icon="{x:Static arc:ArcIcons.Download}"/>
              </arc:SidebarSection>
              <arc:SidebarSection Header="通用">
                <arc:SidebarItem Key="settings" Label="设置" Icon="{x:Static arc:ArcIcons.Settings}"/>
              </arc:SidebarSection>
              <arc:Sidebar.Footer>
              <StackPanel Spacing="8" Margin="0,16,0,0">
                <arc:ThemeSwitcher x:Name="SidebarThemeSwitcher" Variant="Reveal" IsVisible="False"
                                   Text="切换到深色模式" ThemeChangeRequested="SidebarThemeRequested"/>
                <TextBlock Text="● 开发预览" Classes="muted" FontSize="{arc:ArcDesignTokenResource TypeXS}" Margin="12,0,0,0"/>
              </StackPanel>
              </arc:Sidebar.Footer>
            </arc:Sidebar>
            <!-- 实例管理 is a scope of its own: it replaces the whole navigation instead of nesting under it. The back
                 button and the instance name live in the title bar, so the sidebar starts with the section list. -->
            <arc:Sidebar x:Name="InstanceSidebar" Classes="main-sidebar" BorderThickness="0" ExpandedWidth="216" IsCollapsed="False"
                         IsCollapseButtonVisible="False" IsFilterVisible="False" IsVisible="{Binding IsInstance}"
                         Background="Transparent" Label="实例管理导航"
                         SelectedKey="{Binding SelectedInstanceSection.Id, Mode=OneWay}" ItemInvoked="InstanceSidebarItemInvoked">
              <arc:SidebarSection Header="实例">
                <arc:SidebarItem Key="overview" Label="概览"/>
                <arc:SidebarItem Key="presets" Label="预设与配置"/>
                <arc:SidebarItem Key="content" Label="内容与插件"/>
                <arc:SidebarItem Key="pools" Label="地图池"/>
                <arc:SidebarItem Key="admins" Label="管理员"/>
              </arc:SidebarSection>
              <!-- Runtime entries are actions, not pages: IsAction rows are muted and never take the selection block. -->
              <arc:SidebarSection Header="运行">
                <arc:SidebarItem Key="start" Label="启动服务器"/>
                <arc:SidebarItem Key="console" Label="打开控制台"/>
              </arc:SidebarSection>
            </arc:Sidebar>
            </Panel>
          </Border>
        </Grid>
        <Grid Grid.Column="1">
          <pages:HomePage IsVisible="{Binding IsHome}"/>
          <Grid x:Name="InstanceScopeHost" IsVisible="{Binding IsInstance}">
            <pages:InstanceOverviewPage x:Name="InstanceOverview" IsVisible="{Binding IsInstanceOverview}"/>
            <pages:InstancePresetsPage x:Name="InstancePresets" IsVisible="{Binding IsInstancePresets}"/>
            <pages:InstanceContentPage x:Name="InstanceContent" IsVisible="{Binding IsInstanceContent}"/>
            <pages:InstanceMapPoolsPage x:Name="InstanceMapPools" IsVisible="{Binding IsInstancePools}"/>
            <pages:InstanceAdminsPage x:Name="InstanceAdmins" IsVisible="{Binding IsInstanceAdmins}"/>
          </Grid>
          <pages:InstancesPage IsVisible="{Binding IsInstances}"/>
          <pages:DownloadsPage IsVisible="{Binding IsDownloads}"/>
          <pages:SettingsPage x:Name="SettingsPageView" IsVisible="{Binding IsSettings}"/>
        </Grid>
      </Grid>
    <arc:ToastStack x:Name="InstanceNotifications" Position="BottomRight" Duration="0:0:3"/>
  </Grid>
  <controls:WindowModalLayer.Content>
    <Border x:Name="DialogOverlay" IsVisible="False" Background="{arc:ArcDesignTokenResource Scrim}"
            KeyboardNavigation.TabNavigation="Cycle">
      <arc:PresenceHost x:Name="DialogPresence" IsPresent="False" Mode="Scale" EnterScale="0.97">
      <Border x:Name="DialogSurface" Classes="panel dialog-surface" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" MaxWidth="640" MaxHeight="620">
        <!-- ScrollViewer.Padding shrinks its clipped presenter. Put the gutter INSIDE the scroll content instead.
             Matching negative margin preserves the form's position and width, with room for every control's floating shadow. -->
        <ScrollViewer Margin="-32" Padding="0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <ContentControl x:Name="DialogContent" Padding="32" HorizontalContentAlignment="Stretch"/>
        </ScrollViewer>
      </Border>
      </arc:PresenceHost>
    </Border>
  </controls:WindowModalLayer.Content>
</arc:ArcWindow>
