<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:lucide="using:TKCode.Arc.Icons.Lucide"
             x:Class="HCSL.Host.Views.Pages.InstanceOverviewPage"
             x:CompileBindings="False" Classes="instance-overview-page">
  <Border Padding="{DynamicResource ConsolePageInset}">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="{arc:ArcDesignTokenResource Space4}">
        <!-- Runtime actions (start, stop, map change, logs) live in the console window, on the home page and in the
             sidebar's 运行 rows; this scope only holds the instance's own configuration. -->
        <arc:SettingsGroup Header="实例" Appearance="Card">
          <arc:SettingsRow x:Name="NameRow" Header="名称">
            <arc:Input x:Name="NameInput" IsLabelVisible="False" PlaceholderText="实例名称" MaxLength="80"
                       Width="{arc:ArcDesignTokenResource MediaSizeLG}" Description="1–80 个字符"/>
          </arc:SettingsRow>

          <arc:SettingsRow Header="实例 ID">
            <StackPanel Orientation="Horizontal" Spacing="{arc:ArcDesignTokenResource Space2}"
                        VerticalAlignment="Center">
              <SelectableTextBlock x:Name="IdText" VerticalAlignment="Center"
                                   Foreground="{arc:ArcDesignTokenResource TextSecondary}"/>
              <arc:CopyButton x:Name="CopyIdButton" IsIconOnly="True"/>
            </StackPanel>
          </arc:SettingsRow>

          <arc:SettingsRow Header="端口">
            <arc:Input x:Name="PortInput" IsLabelVisible="False" PlaceholderText="27015" MaxLength="5"
                       Width="{arc:ArcDesignTokenResource MediaSizeLG}" Description="1–65535"/>
          </arc:SettingsRow>

          <arc:SettingsRow Header="入服密码">
            <arc:PasswordField x:Name="PasswordInput" PlaceholderText="未设置"
                               Width="{arc:ArcDesignTokenResource MediaSizeLG}" Description="留空表示无密码"/>
          </arc:SettingsRow>
        </arc:SettingsGroup>

        <arc:SettingsGroup Header="部署" Appearance="Card">
          <arc:SettingsGroup.HeaderActions>
            <arc:Button x:Name="RefreshButton" Variant="Ghost" Size="Small" Click="Refresh"
                        Width="{arc:ArcDesignTokenResource Space6}" Height="{arc:ArcDesignTokenResource Space6}"
                        Padding="0">
              <lucide:LucideIcon Kind="RotateCw"/>
            </arc:Button>
          </arc:SettingsGroup.HeaderActions>

          <arc:SettingsRow x:Name="DeployRow" Header="重新部署">
            <StackPanel Orientation="Horizontal" Spacing="{arc:ArcDesignTokenResource Space2}">
              <arc:Button x:Name="DeployButton" Content="部署" Variant="Secondary" Size="Small" Click="DeployServer"/>
              <arc:Button x:Name="RecoverDeployButton" Content="恢复部署" Variant="Secondary" Size="Small" Click="RecoverDeployment"/>
            </StackPanel>
          </arc:SettingsRow>

          <arc:SettingsRow Header="打开目录" Description="旧目录归档后仍可手动取回">
            <arc:Button x:Name="OpenRuntimeButton" Content="打开" Variant="Secondary" Size="Small" Click="OpenRuntime"/>
          </arc:SettingsRow>
        </arc:SettingsGroup>

        <arc:Accordion>
          <arc:AccordionItem Header="高级">
            <arc:SettingsGroup Appearance="Plain">
              <arc:SettingsRow x:Name="LayoutRow" Header="目录布局">
                <StackPanel Orientation="Horizontal" Spacing="{arc:ArcDesignTokenResource Space2}">
                  <TextBlock x:Name="LayoutText" VerticalAlignment="Center"
                             Foreground="{arc:ArcDesignTokenResource TextSecondary}"/>
                  <arc:Button x:Name="MigrateButton" Content="迁移" Variant="Secondary" Size="Small" IsVisible="False"
                              Click="MigrateLayout"/>
                </StackPanel>
              </arc:SettingsRow>

              <arc:SettingsRow x:Name="DeleteRow" Header="删除实例" Description="目录移入回收区，删除后无法恢复">
                <arc:HoldToConfirm x:Name="DeleteConfirm" Label="长按删除实例" ConfirmedLabel="正在删除…"
                                   Height="{arc:ArcDesignTokenResource Space8}" MinHeight="0"
                                   HoldDuration="0:0:1" Tone="Danger" Confirmed="DeleteInstance"/>
              </arc:SettingsRow>
            </arc:SettingsGroup>
          </arc:AccordionItem>
        </arc:Accordion>
      </StackPanel>
    </ScrollViewer>
  </Border>
</UserControl>
