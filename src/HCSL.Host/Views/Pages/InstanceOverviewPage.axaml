<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:lucide="using:TKCode.Arc.Icons.Lucide"
             x:Class="HCSL.Host.Views.Pages.InstanceOverviewPage"
             x:CompileBindings="False" Classes="instance-overview-page">
  <Border Padding="{DynamicResource ConsolePageInset}">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="{arc:ArcDesignTokenResource Space4}">
        <arc:SettingsGroup x:Name="RunGroup" Header="运行" Appearance="Card">
          <arc:SettingsGroup.HeaderActions>
            <StackPanel Orientation="Horizontal" Spacing="{arc:ArcDesignTokenResource Space1}">
              <arc:Button x:Name="HelpButton" Variant="Ghost" Size="Small"
                          Width="{arc:ArcDesignTokenResource Space6}" Height="{arc:ArcDesignTokenResource Space6}"
                          Padding="0">
                <lucide:LucideIcon Kind="CircleQuestionMark"/>
              </arc:Button>
              <arc:Button x:Name="RefreshButton" Variant="Ghost" Size="Small" Click="Refresh"
                          Width="{arc:ArcDesignTokenResource Space6}" Height="{arc:ArcDesignTokenResource Space6}"
                          Padding="0">
                <lucide:LucideIcon Kind="RotateCw"/>
              </arc:Button>
            </StackPanel>
          </arc:SettingsGroup.HeaderActions>

          <arc:SettingsRow x:Name="ServerRow" Header="服务器">
            <StackPanel Orientation="Horizontal" Spacing="{arc:ArcDesignTokenResource Space2}">
              <arc:Button x:Name="StartButton" Content="启动服务器" Variant="Primary" Size="Small" Click="StartServer"/>
              <arc:HoldToConfirm x:Name="StopConfirm" Label="长按停服" ConfirmedLabel="正在停止…"
                                 Height="{arc:ArcDesignTokenResource Space8}" MinHeight="0"
                                 HoldDuration="0:0:1" Tone="Danger" Confirmed="StopServer"/>
            </StackPanel>
          </arc:SettingsRow>

          <arc:SettingsRow Header="端口" Description="本机绑定端口；修改后下次启动生效">
            <StackPanel Orientation="Horizontal" Spacing="{arc:ArcDesignTokenResource Space2}">
              <TextBlock x:Name="PortText" VerticalAlignment="Center"
                         Foreground="{arc:ArcDesignTokenResource TextSecondary}"/>
              <arc:Button x:Name="PortButton" Content="修改" Variant="Secondary" Size="Small" Click="EditPort"/>
            </StackPanel>
          </arc:SettingsRow>

          <arc:SettingsRow Header="连接地址" Description="自动识别的本机网卡地址，访问范围由防火墙控制">
            <TextBlock x:Name="AddressText" VerticalAlignment="Center"
                       Foreground="{arc:ArcDesignTokenResource TextSecondary}"/>
          </arc:SettingsRow>

          <arc:SettingsRow Header="入服密码">
            <arc:Button x:Name="PasswordButton" Content="设置" Variant="Secondary" Size="Small" Click="EditPassword"/>
          </arc:SettingsRow>

          <arc:SettingsRow Header="即时换图" Description="只影响当前运行会话，不改预设">
            <arc:Button x:Name="ChangeMapButton" Content="换图" Variant="Secondary" Size="Small" Click="ChangeMap"/>
          </arc:SettingsRow>

          <arc:SettingsRow x:Name="DeployRow" Header="部署">
            <StackPanel Orientation="Horizontal" Spacing="{arc:ArcDesignTokenResource Space2}">
              <arc:Button x:Name="DeployButton" Content="部署" Variant="Secondary" Size="Small" Click="DeployServer"/>
              <arc:Button x:Name="RecoverDeployButton" Content="恢复部署" Variant="Secondary" Size="Small" Click="RecoverDeployment"/>
              <arc:Button x:Name="RecoverButton" Content="恢复检查" Variant="Secondary" Size="Small" Click="RecoverServer"/>
            </StackPanel>
          </arc:SettingsRow>

          <arc:SettingsRow x:Name="DetailRow" Header="日志">
            <arc:Button x:Name="LogsButton" Content="打开" Variant="Secondary" Size="Small" Click="OpenLogs"/>
          </arc:SettingsRow>
        </arc:SettingsGroup>

        <arc:SettingsGroup Header="实例" Appearance="Card">
          <arc:SettingsRow x:Name="NameRow" Header="名称">
            <arc:Button x:Name="RenameButton" Content="重命名" Variant="Secondary" Size="Small" Click="RenameInstance"/>
          </arc:SettingsRow>

          <arc:SettingsRow x:Name="LayoutRow" Header="目录布局">
            <StackPanel Orientation="Horizontal" Spacing="{arc:ArcDesignTokenResource Space2}">
              <TextBlock x:Name="LayoutText" VerticalAlignment="Center"
                         Foreground="{arc:ArcDesignTokenResource TextSecondary}"/>
              <arc:Button x:Name="MigrateButton" Content="迁移" Variant="Secondary" Size="Small" IsVisible="False"
                          Click="MigrateLayout"/>
            </StackPanel>
          </arc:SettingsRow>

          <arc:SettingsRow Header="运行目录" Description="旧目录归档后仍可手动取回">
            <arc:Button x:Name="OpenRuntimeButton" Content="打开" Variant="Secondary" Size="Small" Click="OpenRuntime"/>
          </arc:SettingsRow>

          <arc:SettingsRow x:Name="DeleteRow" Header="删除实例">
            <arc:HoldToConfirm x:Name="DeleteConfirm" Label="长按删除实例" ConfirmedLabel="正在删除…"
                               Height="{arc:ArcDesignTokenResource Space8}" MinHeight="0"
                               HoldDuration="0:0:1" Tone="Danger" Confirmed="DeleteInstance"/>
          </arc:SettingsRow>
        </arc:SettingsGroup>
      </StackPanel>
    </ScrollViewer>
  </Border>
</UserControl>
