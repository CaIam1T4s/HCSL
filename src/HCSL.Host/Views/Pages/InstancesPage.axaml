<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:lucide="using:TKCode.Arc.Icons.Lucide"
             xmlns:vm="using:HCSL.Host.ViewModels"
             xmlns:ui="using:HCSL.UI.Shared.Services"
             xmlns:controls="using:HCSL.UI.Shared.Controls"
             x:Class="HCSL.Host.Views.Pages.InstancesPage" x:DataType="vm:ShellViewModel" Classes="instance-list-page">
  <UserControl.Styles>
    <!-- Surface-only transparency: glass menus/cards and foreground content keep their native material/opacity. -->
    <Style Selector=".instance-list-page arc|Button, .instance-list-page arc|FieldIconButton, .instance-list-page arc|ExpandingButtonGroupItem, .instance-list-page arc|HoldToConfirm">
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector=".instance-list-page arc|Button:not(.instance-back)">
      <Setter Property="Background" Value="{CompiledBinding $parent[Window].Background, Converter={x:Static ui:SurfaceBrushConverter.Instance}, ConverterParameter=0.72}"/>
    </Style>
    <Style Selector=".instance-list-page arc|SearchField /template/ arc|FieldFrame#PART_Frame">
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Background" Value="{CompiledBinding $parent[Window].Background, Converter={x:Static ui:SurfaceBrushConverter.Instance}, ConverterParameter=0.72}"/>
    </Style>
    <Style Selector=".instance-list-page arc|SearchField /template/ arc|FieldFrame#PART_Frame:pointerover:not(:invalid)">
      <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector=".instance-list-page arc|SearchField /template/ arc|FieldFrame#PART_Frame:focus-active:not(:invalid)">
      <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <!-- The hit area stays fixed; only Arc's pill and its native spring-driven items size from the right edge. -->
    <Style Selector="arc|ExpandingButtonGroup.instance-actions /template/ Panel">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="arc|ExpandingButtonGroup.instance-actions /template/ Border#PART_Pill">
      <Setter Property="HorizontalAlignment" Value="Right"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="ui:CenteredShadow.Source" Value="{arc:ArcDesignTokenResource ShadowRaised}"/>
    </Style>
    <Style Selector="arc|ExpandingButtonGroup.instance-actions:focus-within /template/ Border#PART_Pill">
      <Setter Property="ui:CenteredShadow.Source" Value="{arc:ArcDesignTokenResource ShadowFloating}"/>
    </Style>
    <Style Selector=".instance-list-page arc|HoldToConfirm /template/ Border#PART_Surface">
      <Setter Property="Background" Value="{DynamicResource FloatingSurfaceBackground}"/>
      <Setter Property="ui:CenteredShadow.Source" Value="{arc:ArcDesignTokenResource ShadowRaised}"/>
    </Style>
    <Style Selector=".instance-list-page arc|HoldToConfirm:focus-within /template/ Border#PART_Surface">
      <Setter Property="ui:CenteredShadow.Source" Value="{arc:ArcDesignTokenResource ShadowFloating}"/>
    </Style>
    <Style Selector="TextBlock.instance-property-value">
      <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}"/>
      <Setter Property="HorizontalAlignment" Value="Right"/>
      <Setter Property="TextAlignment" Value="Right"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
  </UserControl.Styles>
  <Grid Margin="32" RowDefinitions="Auto,Auto,*" RowSpacing="{arc:ArcDesignTokenResource Space4}">
    <StackPanel Orientation="Horizontal" Spacing="{arc:ArcDesignTokenResource Space3}">
      <TextBlock Classes="heading" Text="实例列表" VerticalAlignment="Center"/>
    </StackPanel>
    <Grid x:Name="InstancesToolbar" Grid.Row="1" ColumnDefinitions="3*,*,Auto" ColumnSpacing="{arc:ArcDesignTokenResource Space4}">
      <controls:ElevatedSurface Classes="instance-search" HorizontalAlignment="Left" MaxWidth="{arc:ArcDesignTokenResource ContentMaxWidthSM}">
        <arc:SearchField x:Name="Search" Label="搜索实例" IsLabelVisible="False" Placeholder="搜索名称、预设或端口"
                         TextChanged="SearchChanged" MinWidth="{arc:ArcDesignTokenResource MediaSizeXL}"/>
      </controls:ElevatedSurface>
      <Grid x:Name="ToolbarSlot" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
            Width="{arc:ArcDesignTokenResource MediaSizeXL}">
        <arc:ExpandingButtonGroup x:Name="ToolbarActions" Classes="launch-actions instance-actions" Label="实例列表操作"
                                  HorizontalAlignment="Stretch" ClipToBounds="False">
          <arc:ExpandingButtonGroupItem x:Name="RefreshButton" Label="刷新实例" Click="RefreshInstances"/>
          <arc:ExpandingButtonGroupItem x:Name="CreateButton" Label="创建实例" Click="CreateInstance"/>
          <arc:ExpandingButtonGroupItem x:Name="SortButton" Label="名称降序" Click="OpenSortMenu"/>
        </arc:ExpandingButtonGroup>
      </Grid>
    </Grid>
    <arc:SkeletonMorph x:Name="LoadingRegion" Grid.Row="2" LoadingLabel="读取实例列表" Background="Transparent">
        <Grid>
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <arc:RadioGroup x:Name="InstanceChoices" AutomationProperties.Name="启动实例"
                            SelectionChanged="StartupSelectionChanged" ContextRequested="RowContextRequested">
              <arc:RadioGroup.ItemTemplate>
                <DataTemplate x:DataType="vm:InstanceListRow">
                  <arc:PresenceHost x:Name="RowPresence" Mode="Scale" EnterScale="0.97" IsPresent="{Binding IsPresent}" Exited="RowExited">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{arc:ArcDesignTokenResource Space4}">
                    <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Center">
                      <arc:MorphBlock Lines="1" SkeletonWidthRatio="0.6" LineHeight="{arc:RadioGroupTokenResource LabelLineHeight}">
                        <TextBlock Text="{Binding Name}" TextAlignment="Left" TextTrimming="CharacterEllipsis"
                                   LineHeight="{arc:RadioGroupTokenResource LabelLineHeight}" Foreground="{arc:ArcDesignTokenResource Foreground}"/>
                      </arc:MorphBlock>
                      <arc:MorphBlock Lines="1" SkeletonWidthRatio="0.45" LineHeight="{arc:RadioGroupTokenResource LabelLineHeight}">
                        <TextBlock Text="{Binding Subtitle}" Classes="instance-subtitle" TextAlignment="Left"
                                   LineHeight="{arc:RadioGroupTokenResource LabelLineHeight}" TextTrimming="CharacterEllipsis"/>
                      </arc:MorphBlock>
                    </StackPanel>
                    <arc:MorphBlock Grid.Column="1" SkeletonWidth="{arc:ArcDesignTokenResource ControlSizeLG}"
                                    SkeletonHeight="{arc:RadioGroupTokenResource RingDiameter}"
                                    HorizontalAlignment="Right" VerticalAlignment="Center">
                      <arc:Badge Content="{Binding StatusText}" Tone="{Binding StatusTone}"
                                 HorizontalAlignment="Right" VerticalAlignment="Center">
                        <arc:Badge.Icon><lucide:LucideIcon Kind="{Binding StatusIcon}"/></arc:Badge.Icon>
                      </arc:Badge>
                    </arc:MorphBlock>
                  </Grid>
                  </arc:PresenceHost>
                </DataTemplate>
              </arc:RadioGroup.ItemTemplate>
              <arc:RadioGroup.Styles>
                <Style Selector="arc|RadioGroupItem" x:DataType="vm:InstanceListRow">
                  <Setter Property="AutomationProperties.Name" Value="{Binding StartupLabel}"/>
                  <Setter Property="IsEnabled" Value="{Binding IsPresent}"/>
                </Style>
              </arc:RadioGroup.Styles>
            </arc:RadioGroup>
          </ScrollViewer>
          <arc:EmptyState x:Name="Empty" Title="暂无实例" Description="创建一个实例以开始使用。" IsVisible="False"/>
        </Grid>
    </arc:SkeletonMorph>
    <Canvas x:Name="PropertyAnchorLayer" Grid.RowSpan="3" IsHitTestVisible="False">
      <Border x:Name="PropertiesAnchor" Width="{arc:ArcDesignTokenResource Space1}" Height="{arc:ArcDesignTokenResource Space1}"/>
      <Border x:Name="DeleteAnchor" Width="{arc:ArcDesignTokenResource Space1}" Height="{arc:ArcDesignTokenResource Space1}"/>
      <!-- Anchors the context menu at the exact pointer point: Avalonia's Pointer placement was unreliable on the
           panel's first popup, when its popup root did not exist yet. -->
      <Border x:Name="MenuAnchor" Width="{arc:ArcDesignTokenResource Space1}" Height="{arc:ArcDesignTokenResource Space1}"/>
    </Canvas>
    <arc:Popover x:Name="PropertiesPopover" Placement="Bottom" Alignment="Start" Offset="0" TriggerMode="Manual">
      <arc:Popover.Styles>
        <Style Selector="arc|PopoverSurface">
          <Setter Property="Background" Value="Transparent"/>
          <Setter Property="BorderThickness" Value="0"/>
          <Setter Property="Padding" Value="0"/>
        </Style>
      </arc:Popover.Styles>
      <arc:GlassCard x:Name="PropertiesCard" x:DataType="vm:InstanceListRow" DataContext="{x:Null}"
                     MinWidth="{arc:ArcDesignTokenResource MediaSizeXL}" MaxWidth="{arc:ArcDesignTokenResource ContentMaxWidthSM}">
        <StackPanel Spacing="{arc:ArcDesignTokenResource Space4}">
          <TextBlock Text="实例属性" FontSize="{arc:ArcDesignTokenResource TypeLG}" FontWeight="Medium"/>
          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                ColumnSpacing="{arc:ArcDesignTokenResource Space6}" RowSpacing="{arc:ArcDesignTokenResource Space3}">
            <TextBlock Text="名称" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Classes="instance-property-value" Text="{Binding Name}"/>
            <TextBlock Grid.Row="1" Text="状态" VerticalAlignment="Center"/>
            <arc:Badge Grid.Row="1" Grid.Column="1" Content="{Binding StatusText}" Tone="{Binding StatusTone}"
                       HorizontalAlignment="Right" VerticalAlignment="Center">
              <arc:Badge.Icon><lucide:LucideIcon Kind="{Binding StatusIcon}"/></arc:Badge.Icon>
            </arc:Badge>
            <TextBlock Grid.Row="2" Text="预设"/>
            <TextBlock Grid.Row="2" Grid.Column="1" Classes="instance-property-value" Text="{Binding PresetName}"/>
            <TextBlock Grid.Row="3" Text="端口"/>
            <TextBlock Grid.Row="3" Grid.Column="1" Classes="instance-property-value" Text="{Binding Port}"/>
            <TextBlock Grid.Row="4" Text="创建时间"/>
            <TextBlock Grid.Row="4" Grid.Column="1" Classes="instance-property-value" Text="{Binding CreatedAt}"/>
            <TextBlock Grid.Row="5" Text="最后一次运行"/>
            <TextBlock Grid.Row="5" Grid.Column="1" Classes="instance-property-value" Text="{Binding LastRunAt}"/>
          </Grid>
        </StackPanel>
      </arc:GlassCard>
    </arc:Popover>
    <!-- The standalone confirmation has no extra popup frame or rectangular host shadow. -->
    <arc:Popover x:Name="DeletePopover" Placement="Bottom" Alignment="Start" Offset="0" TriggerMode="Manual" HasShadow="False">
      <arc:Popover.Styles>
        <Style Selector="arc|PopoverSurface">
          <Setter Property="Background" Value="Transparent"/>
          <Setter Property="Padding" Value="0"/>
          <Setter Property="BorderThickness" Value="0"/>
        </Style>
      </arc:Popover.Styles>
      <arc:HoldToConfirm x:Name="DeleteConfirm" Label="长按删除实例" ConfirmedLabel="正在删除…"
                         Tone="Danger" Confirmed="ConfirmDelete" HorizontalAlignment="Left"
                         AutomationProperties.HelpText="删除后无法恢复"/>
    </arc:Popover>
  </Grid>
</UserControl>
