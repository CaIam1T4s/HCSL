<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="HCSL.Host.Views.Pages.PresetCfgPage">
  <Grid Margin="{DynamicResource ConsolePageInset}" RowDefinitions="Auto,*" RowSpacing="{arc:ArcDesignTokenResource Space4}">
    <WrapPanel HorizontalAlignment="Right" ItemSpacing="{arc:ArcDesignTokenResource Space2}">
      <arc:Button Content="从插件同步" Variant="Secondary" Click="SyncPlugins"/>
      <arc:Button Content="刷新" Variant="Secondary" Click="Refresh"/>
    </WrapPanel>
    <arc:SelectionToolbar Grid.Row="1" x:Name="Selection" Classes="selection-actions" ActionInvoked="Exec" SelectAllRequested="SelectAll" Cleared="ClearSelection">
      <arc:TreeTable x:Name="CfgTree" Caption="CFG 文件" IsSelectable="True"/>
    </arc:SelectionToolbar>
  </Grid>
</UserControl>
