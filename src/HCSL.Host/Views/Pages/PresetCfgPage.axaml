<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="HCSL.Host.Views.Pages.PresetCfgPage">
  <Grid Margin="{DynamicResource ConsolePageInset}" RowDefinitions="Auto,*" RowSpacing="{arc:ArcDesignTokenResource Space4}">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{arc:ArcDesignTokenResource Space3}">
      <arc:SearchField x:Name="Search" Label="搜索 CFG" IsLabelVisible="False" Placeholder="搜索 CFG 名称或路径"
                       HorizontalAlignment="Left" VerticalAlignment="Center" MaxWidth="240" TextChanged="SearchChanged"/>
      <arc:ExpandingButtonGroup Grid.Column="1" VerticalAlignment="Center" Label="CFG 操作">
      <arc:ExpandingButtonGroupItem x:Name="RefreshButton" Label="刷新" Click="Refresh"/>
      <arc:ExpandingButtonGroupItem x:Name="SyncButton" Label="从插件同步" Click="SyncPlugins"/>
      </arc:ExpandingButtonGroup>
    </Grid>
    <arc:SelectionToolbar Grid.Row="1" x:Name="Selection" Classes="selection-actions" ActionInvoked="Exec" SelectAllRequested="SelectAll" Cleared="ClearSelection">
      <arc:TreeTable x:Name="CfgTree" Caption="CFG 文件" IsSelectable="True"/>
    </arc:SelectionToolbar>
  </Grid>
</UserControl>
