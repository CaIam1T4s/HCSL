<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="HCSL.Host.Views.Pages.PresetCfgPage">
  <Grid Margin="{DynamicResource ConsolePageInset}" RowDefinitions="Auto,*" RowSpacing="{arc:ArcDesignTokenResource Space4}">
    <WrapPanel HorizontalAlignment="Right" ItemSpacing="{arc:ArcDesignTokenResource Space2}">
      <arc:Button Content="刷新" Variant="Secondary" Click="Refresh"/>
      <arc:Button x:Name="ExecButton" Content="执行 exec" Variant="Secondary" IsEnabled="False" Click="Exec"/>
    </WrapPanel>
    <arc:TreeTable Grid.Row="1" x:Name="CfgTree" Caption="CFG 文件" IsSelectable="True"/>
  </Grid>
</UserControl>
