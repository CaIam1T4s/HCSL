<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:vm="using:HCSL.Host.ViewModels"
             x:Class="HCSL.Host.Views.Pages.PresetMapPoolPage"
             x:CompileBindings="False" Classes="preset-pool-page">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="{DynamicResource InstancePageInset}" Spacing="{arc:ArcDesignTokenResource Space12}">
      <StackPanel Spacing="{arc:ArcDesignTokenResource Space4}">
        <!-- Pools belong to the instance; a preset only picks one of them, so there is no create/delete here. -->
        <arc:RadioGroup x:Name="PoolChoices" AutomationProperties.Name="本预设使用的图池"
                        SelectionChanged="PoolSelected">
          <arc:RadioGroup.ItemTemplate>
            <DataTemplate x:DataType="vm:MapPoolRow">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{arc:ArcDesignTokenResource Space4}">
                <StackPanel Spacing="{arc:ArcDesignTokenResource Space1}" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Name}" Foreground="{arc:ArcDesignTokenResource Foreground}"/>
                  <TextBlock Text="{Binding Presets}" Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                             FontSize="{arc:ArcDesignTokenResource TypeXS}"/>
                </StackPanel>
                <arc:Badge Grid.Column="1" Size="Small" Tone="{Binding Tone}" Content="{Binding Count}"
                           VerticalAlignment="Center"/>
              </Grid>
            </DataTemplate>
          </arc:RadioGroup.ItemTemplate>
        </arc:RadioGroup>
        <TextBlock x:Name="MapsText" Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                   TextWrapping="Wrap"/>
        <TextBlock x:Name="EmptyHint" IsVisible="False" Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                   Text="实例还没有图池，请先在实例的地图池里创建"/>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
