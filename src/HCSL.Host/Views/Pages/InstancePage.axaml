<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:arc="https://github.com/AIDotNet/TKCode.Arc" x:Class="HCSL.Host.Views.Pages.InstancePage">
  <ScrollViewer>
    <StackPanel Margin="32" Spacing="16">
      <TextBlock Classes="heading" Text="实例管理"/>
      <TextBlock Classes="muted" Text="复用本机宿主的服务器会话；关闭窗口不自动停服。"/>
      <arc:Select x:Name="InstanceSelect" Placeholder="选择实例"/>
      <WrapPanel>
        <arc:Button x:Name="RefreshButton" Content="连接宿主 / 刷新实例" Variant="Secondary" Click="RefreshInstances" Margin="0,0,8,8"/>
        <arc:Button x:Name="StartButton" Content="启动" Variant="Secondary" Click="StartServer" Margin="0,0,8,8"/>
        <arc:Button x:Name="DeployButton" Content="部署（不启动）" Variant="Secondary" Click="DeployServer" Margin="0,0,8,8"/>
        <arc:Button x:Name="RecoverDeployButton" Content="恢复部署" Variant="Secondary" Click="RecoverDeployment" Margin="0,0,8,8"/>
        <arc:Button x:Name="StopButton" Content="停服" Variant="Secondary" Click="StopServer" Margin="0,0,8,8"/>
        <arc:Button x:Name="RecoverButton" Content="恢复检查" Variant="Secondary" Click="RecoverServer" Margin="0,0,8,8"/>
        <arc:Button Content="进度 / 日志" Variant="Secondary" Click="OpenLogs" Margin="0,0,8,8"/>
        <arc:Button x:Name="ChangeMapButton" Content="即时换图" Variant="Secondary" Click="ChangeMap" Margin="0,0,8,8"/>
        <arc:Button x:Name="PasswordButton" Content="实例入服密码" Variant="Secondary" Click="EditPassword" Margin="0,0,8,8"/>
      </WrapPanel>
      <Border Classes="panel"><StackPanel Spacing="12">
        <TextBlock x:Name="SelectionText" TextWrapping="Wrap"/>
        <TextBlock x:Name="StateText" TextWrapping="Wrap"/>
        <TextBlock x:Name="DetailText" TextWrapping="Wrap"/>
        <TextBlock x:Name="ErrorText" TextWrapping="Wrap"/>
      </StackPanel></Border>
      <Border Classes="panel"><StackPanel Spacing="12">
        <TextBlock Classes="subheading" Text="配置预设"/>
        <TextBlock x:Name="PresetStatusText" TextWrapping="Wrap"/>
        <arc:Select x:Name="PresetSelect" Placeholder="浏览配置预设（不立即切换）"/>
        <WrapPanel>
          <arc:Button x:Name="CreatePresetButton" Content="新建预设" Variant="Secondary" Click="CreatePreset" Margin="0,0,8,8"/>
          <arc:Button x:Name="CopyPresetButton" Content="复制预设" Variant="Secondary" Click="CopyPreset" Margin="0,0,8,8"/>
          <arc:Button x:Name="EditPresetButton" Content="编辑预设" Variant="Secondary" Click="EditPreset" Margin="0,0,8,8"/>
          <arc:Button x:Name="SelectPresetButton" Content="设为当前所选" Variant="Secondary" Click="SelectPreset" Margin="0,0,8,8"/>
          <arc:Button x:Name="DeletePresetButton" Content="删除预设" Variant="Secondary" Click="DeletePreset" Margin="0,0,8,8"/>
          <arc:Button x:Name="MapPoolButton" Content="地图池" Variant="Secondary" Click="EditPresetMapPool" Margin="0,0,8,8"/>
          <arc:Button x:Name="EditCfgButton" Content="CFG 管理" Variant="Secondary" Click="EditPresetCfg" Margin="0,0,8,8"/>
          <arc:Button x:Name="PluginsButton" Content="插件" Variant="Secondary" Click="EditPresetPlugins" Margin="0,0,8,8"/>
          <arc:Button x:Name="OpenCfgButton" Content="打开 CFG 目录" Variant="Secondary" Click="OpenPresetCfg" Margin="0,0,8,8"/>
          <arc:Button x:Name="OpenAddonsButton" Content="打开预设 addons" Variant="Secondary" Click="OpenPresetAddons" Margin="0,0,8,8"/>
          <arc:Button x:Name="OpenRuntimeButton" Content="打开运行目录" Variant="Secondary" Click="OpenRuntime" Margin="0,0,8,8"/>
        </WrapPanel>
        <TextBlock Classes="muted" TextWrapping="Wrap" Text="下拉框只浏览；点击“设为当前所选”才保存。运行或恢复检查期间禁止修改。CFG 目录属于此实例的此预设；外部编辑可能影响正在运行的服务器，请先停服。"/>
      </StackPanel></Border>
      <TextBlock Classes="muted" TextWrapping="Wrap" Text="启动可能先自动部署；预检、低内存提示和清理结果均以宿主快照为准。启动失败不等于清理完成。"/>
      <Border Classes="panel"><StackPanel Spacing="8">
        <TextBlock Classes="subheading" Text="尚未接入的 GUI 编辑功能"/>
        <TextBlock Classes="muted" TextWrapping="Wrap" Text="实例创建、编辑、删除请前往“实例列表”；预设与 CFG 管理见上方（保存与 exec 分离）；插件版本/启用清单见“插件”；参赛授权编辑尚未接入此界面。VAC 与 GSLT 继续延后。日志窗口支持本机服主通用单行命令、exec、alias、命令链与换图；不逐条确认，回执不代表引擎执行成功。"/>
      </StackPanel></Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
