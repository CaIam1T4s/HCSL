<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:arc="https://github.com/AIDotNet/TKCode.Arc" x:Class="HCSL.Host.Views.Pages.InstancePage">
  <ScrollViewer>
    <StackPanel Margin="32" Spacing="16">
      <TextBlock Classes="heading" Text="实例管理"/>
      <TextBlock Classes="muted" Text="复用本机宿主的服务器会话；关闭窗口不自动停服。"/>
      <arc:Select x:Name="InstanceSelect" Placeholder="选择实例"/>
      <WrapPanel>
        <arc:Button x:Name="RefreshButton" Content="连接宿主 / 刷新实例" Variant="Secondary" Click="RefreshInstances" Margin="0,0,8,8"/>
        <arc:Button x:Name="StartButton" Content="启动" Variant="Secondary" Click="StartServer" Margin="0,0,8,8"/>
        <arc:Button x:Name="StopButton" Content="停服" Variant="Secondary" Click="StopServer" Margin="0,0,8,8"/>
        <arc:Button x:Name="RecoverButton" Content="恢复检查" Variant="Secondary" Click="RecoverServer" Margin="0,0,8,8"/>
        <arc:Button Content="进度 / 日志" Variant="Secondary" Click="OpenLogs" Margin="0,0,8,8"/>
        <arc:Button x:Name="PasswordButton" Content="实例入服密码" Variant="Secondary" Click="EditPassword" Margin="0,0,8,8"/>
      </WrapPanel>
      <Border Classes="panel"><StackPanel Spacing="12">
        <TextBlock x:Name="SelectionText" TextWrapping="Wrap"/>
        <TextBlock x:Name="StateText" TextWrapping="Wrap"/>
        <TextBlock x:Name="DetailText" TextWrapping="Wrap"/>
        <TextBlock x:Name="ErrorText" TextWrapping="Wrap"/>
      </StackPanel></Border>
      <TextBlock Classes="muted" TextWrapping="Wrap" Text="启动可能先自动部署；预检、低内存提示和清理结果均以宿主快照为准。启动失败不等于清理完成。"/>
      <Border Classes="panel"><StackPanel Spacing="8">
        <TextBlock Classes="subheading" Text="尚未接入的 GUI 编辑功能"/>
        <TextBlock Classes="muted" TextWrapping="Wrap" Text="实例创建、编辑、删除请前往“实例列表”；预设 CRUD、CFG、插件和参赛授权编辑尚未接入此界面，可使用 TUI 的已实现入口。VAC 与 GSLT 继续延后。本界面不提供交互式服务器控制台。"/>
      </StackPanel></Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
