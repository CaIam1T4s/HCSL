<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:pages="using:HCSL.Host.Views.Pages"
             x:Class="HCSL.Host.Views.Pages.InstanceAdminsPage" x:CompileBindings="False" Classes="instance-admins-page">
  <Border Padding="{DynamicResource ConsolePageInset}">
    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="{arc:ArcDesignTokenResource Space3}">
      <WrapPanel ItemSpacing="{arc:ArcDesignTokenResource Space2}" LineSpacing="{arc:ArcDesignTokenResource Space2}">
        <arc:Button x:Name="EditButton" Content="编辑管理员" Variant="Primary" Size="Medium" Click="EditAdmins"/>
        <arc:Button x:Name="ReloadButton" Content="重载权限" Variant="Secondary" Size="Medium" Click="Reload"/>
        <arc:Button x:Name="RefreshButton" Content="刷新" Variant="Secondary" Size="Medium" Click="Refresh"/>
      </WrapPanel>
      <TextBlock x:Name="SourceText" Grid.Row="1" Foreground="{arc:ArcDesignTokenResource TextSecondary}"/>
      <arc:Table x:Name="Admins" Grid.Row="2" Caption="管理员" IsSelectable="False"
                 EmptyMessage="还没有管理员" LoadingMessage="正在读取管理员"
                 ItemNameOne="名管理员" ItemNameOther="名管理员">
        <arc:Table.Columns>
          <arc:DataTableColumn Header="名字" x:DataType="pages:InstanceAdminsPage+AdminRow" Binding="{CompiledBinding DisplayName}" Width="200"/>
          <arc:DataTableColumn Header="SteamID" x:DataType="pages:InstanceAdminsPage+AdminRow" Binding="{CompiledBinding SteamId}" Width="220"/>
          <arc:DataTableColumn Header="组" x:DataType="pages:InstanceAdminsPage+AdminRow" Binding="{CompiledBinding Groups}" Width="*"/>
        </arc:Table.Columns>
      </arc:Table>
    </Grid>
  </Border>
</UserControl>
