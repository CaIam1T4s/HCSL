<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:HCSL.Host.ViewModels" xmlns:arc="https://github.com/AIDotNet/TKCode.Arc" x:Class="HCSL.Host.Views.Pages.NetworkPage" x:DataType="vm:ShellViewModel">
  <ScrollViewer>
    <StackPanel Margin="36" Spacing="22">
      <TextBlock Classes="heading" Text="联机组网"/>
      <TextBlock Classes="muted" Text="通过 EasyTier 与玩家建立私有网络。"/>
      <Border Classes="panel">
        <StackPanel Spacing="12">
          <TextBlock Classes="subheading" Text="EasyTier · 未接入"/>
          <TextBlock Classes="muted" Text="网络组件尚未启动，当前没有虚拟地址或可分享的邀请。"/>
          <StackPanel Orientation="Horizontal" Spacing="12">
            <arc:Button Content="创建网络" IsEnabled="False" HorizontalAlignment="Left" Variant="Secondary"/>
            <arc:Button Content="加入网络" IsEnabled="False" HorizontalAlignment="Left" Variant="Secondary"/>
          </StackPanel>
        </StackPanel>
      </Border>
      <Border Classes="panel">
        <StackPanel Spacing="12">
          <TextBlock Classes="subheading" Text="连接信息"/>
          <TextBlock Classes="muted" Text="虚拟 IP：未分配&#10;关联实例：未选择&#10;邀请信息：尚未生成"/>
        </StackPanel>
      </Border>
      <Border Classes="notice">
        <TextBlock Classes="muted" Text="私有组网需要玩家运行兼容客户端，不等于公网发布，也不代表已被 Steam 社区服列表收录。"/>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
