<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="HCSL.Host.Views.Pages.PresetPluginsPage">
  <Grid Margin="{DynamicResource ConsolePageInset}" RowDefinitions="Auto,*" RowSpacing="{arc:ArcDesignTokenResource Space4}">
    <arc:FilterToolbar x:Name="Filters" IsSearchVisible="True" SearchPlaceholder="搜索插件名称或 ID"
                       Label="插件筛选" EmptyText="没有已应用的筛选" AddFilterLabel="筛选" ClearAllLabel="清除筛选" FiltersChanged="FilterPlugins">
      <arc:FilterToolbar.Actions>
        <arc:ExpandingButtonGroup Label="插件列表操作">
          <arc:ExpandingButtonGroupItem x:Name="RefreshButton" Label="刷新" Click="Refresh"/>
          <arc:ExpandingButtonGroupItem x:Name="ManageButton" Label="导入与高级管理" IsEnabled="False" Click="Manage"/>
        </arc:ExpandingButtonGroup>
      </arc:FilterToolbar.Actions>
      <arc:FilterToolbar.Fields>
        <arc:FilterField Id="framework" Label="框架"/>
        <arc:FilterField Id="state" Label="状态">
          <arc:FilterField.Options>
            <arc:FilterOption Value="enabled" Label="启用"/>
            <arc:FilterOption Value="disabled" Label="禁用"/>
            <arc:FilterOption Value="incompatible" Label="不兼容"/>
          </arc:FilterField.Options>
        </arc:FilterField>
      </arc:FilterToolbar.Fields>
    </arc:FilterToolbar>
    <Grid Grid.Row="1" ClipToBounds="True">
      <arc:Table x:Name="Plugins" Caption="预设插件" IsSelectable="True"
                 EmptyMessage="暂无插件" LoadingMessage="正在读取插件"/>
      <Canvas x:Name="TintLayer" IsHitTestVisible="False" ClipToBounds="True"/>
    </Grid>
    <arc:Popover x:Name="PluginProperties" Grid.Row="1" Placement="Bottom" Alignment="Start" Offset="0" TriggerMode="Manual">
      <arc:Popover.Styles>
        <Style Selector="arc|PopoverSurface">
          <Setter Property="Background" Value="Transparent"/>
          <Setter Property="BorderThickness" Value="0"/>
          <Setter Property="Padding" Value="0"/>
        </Style>
      </arc:Popover.Styles>
      <arc:GlassCard MinWidth="240">
        <StackPanel Spacing="{arc:ArcDesignTokenResource Space4}">
          <TextBlock Text="插件属性" FontSize="{arc:ArcDesignTokenResource TypeLG}" FontWeight="Medium"/>
          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="{arc:ArcDesignTokenResource Space6}"
                RowSpacing="{arc:ArcDesignTokenResource Space3}">
            <TextBlock Text="名称"/><TextBlock Grid.Column="1" x:Name="PropertyName" Classes="instance-property-value"/>
            <TextBlock Grid.Row="1" Text="版本"/><TextBlock Grid.Row="1" Grid.Column="1" x:Name="PropertyVersion" Classes="instance-property-value"/>
            <TextBlock Grid.Row="2" Text="框架"/><TextBlock Grid.Row="2" Grid.Column="1" x:Name="PropertyFramework" Classes="instance-property-value"/>
          </Grid>
        </StackPanel>
      </arc:GlassCard>
    </arc:Popover>
  </Grid>
</UserControl>
