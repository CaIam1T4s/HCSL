<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:lucide="using:TKCode.Arc.Icons.Lucide"
             xmlns:frontend="using:HCSL.Frontend"
             x:Class="HCSL.Host.Views.Pages.InstancePresetsPage"
             x:CompileBindings="False" Classes="instance-presets-page">
  <Grid RowDefinitions="Auto,*" RowSpacing="{arc:ArcDesignTokenResource Space4}" Margin="{DynamicResource ConsolePageInset}">
    <arc:Button x:Name="CreateButton" Variant="Secondary" HorizontalAlignment="Right"
                Click="CreatePreset" AutomationProperties.Name="新建预设">
      <StackPanel Orientation="Horizontal" Spacing="{arc:ArcDesignTokenResource Space2}">
        <lucide:LucideIcon Kind="Plus" VerticalAlignment="Center"/>
        <TextBlock Text="新建预设" VerticalAlignment="Center"/>
      </StackPanel>
    </arc:Button>
    <Grid Grid.Row="1">
      <arc:Table x:Name="PresetChoices" Caption="预设列表" IsSelectable="False"
                 EmptyMessage="暂无预设" LoadingMessage="正在读取预设">
        <arc:Table.Columns>
          <arc:DataTableColumn Header="预设名" Width="*" IsSortable="False">
            <arc:DataTableColumn.CellTemplate>
              <DataTemplate x:DataType="frontend:HostPresetItem">
                <TextBlock Text="{CompiledBinding Definition.Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
              </DataTemplate>
            </arc:DataTableColumn.CellTemplate>
          </arc:DataTableColumn>
          <arc:DataTableColumn Header="地图" Width="*" IsSortable="False">
            <arc:DataTableColumn.CellTemplate>
              <DataTemplate x:DataType="frontend:HostPresetItem">
                <TextBlock Text="{CompiledBinding Definition.Map}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
              </DataTemplate>
            </arc:DataTableColumn.CellTemplate>
          </arc:DataTableColumn>
          <arc:DataTableColumn Header="状态" Width="112" IsSortable="False">
            <arc:DataTableColumn.CellTemplate>
              <DataTemplate x:DataType="frontend:HostPresetItem">
                <arc:Badge Size="Small" Tone="Success" Content="启动预设" IsVisible="{CompiledBinding Selected}"
                           HorizontalAlignment="Left" VerticalAlignment="Center"/>
              </DataTemplate>
            </arc:DataTableColumn.CellTemplate>
          </arc:DataTableColumn>
          <arc:DataTableColumn Header="操作" Width="72" IsSortable="False">
            <arc:DataTableColumn.CellTemplate>
              <DataTemplate x:DataType="frontend:HostPresetItem">
                <arc:Button Classes="preset-row-action" Content="⋯" Variant="Ghost" Size="Small" Click="OpenPresetActions"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            AutomationProperties.Name="{CompiledBinding Definition.Name, StringFormat='操作预设：{0}'}"/>
              </DataTemplate>
            </arc:DataTableColumn.CellTemplate>
          </arc:DataTableColumn>
        </arc:Table.Columns>
      </arc:Table>
      <Canvas x:Name="PresetMenuLayer" IsHitTestVisible="False">
        <Border x:Name="PresetMenuAnchor" Width="1" Height="1"/>
      </Canvas>
      <arc:Popover x:Name="DeletePopover" Placement="Bottom" Alignment="Start" Offset="0" TriggerMode="Manual" HasShadow="False">
        <arc:Popover.Styles>
          <Style Selector="arc|PopoverSurface">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
          </Style>
        </arc:Popover.Styles>
        <arc:HoldToConfirm x:Name="DeleteButton" Label="长按删除预设" ConfirmedLabel="正在删除…"
                           HoldDuration="0:0:1" Tone="Danger" Confirmed="DeletePreset"/>
      </arc:Popover>
    </Grid>
  </Grid>
</UserControl>
