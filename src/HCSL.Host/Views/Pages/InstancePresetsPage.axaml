<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:lucide="using:TKCode.Arc.Icons.Lucide"
             xmlns:frontend="using:HCSL.Frontend"
             x:Class="HCSL.Host.Views.Pages.InstancePresetsPage" Classes="instance-presets-page">
  <Border Padding="{DynamicResource ConsolePageInset}">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="{arc:ArcDesignTokenResource Space4}">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{arc:ArcDesignTokenResource Space3}">
          <StackPanel Spacing="{arc:ArcDesignTokenResource Space1}" VerticalAlignment="Center">
            <TextBlock Text="预设" FontSize="{arc:ArcDesignTokenResource TypeLG}" FontWeight="SemiBold"/>
            <TextBlock Text="选中预设可查看配置，不会切换启动预设。" TextWrapping="Wrap"
                       Foreground="{arc:ArcDesignTokenResource TextSecondary}"/>
          </StackPanel>
          <arc:Button Grid.Column="1" x:Name="CreateButton" Content="新建预设" Variant="Primary" Size="Medium"
                      VerticalAlignment="Center" Click="CreatePreset"/>
        </Grid>
        <arc:RadioGroup x:Name="PresetChoices" AutomationProperties.Name="配置预设"
                        SelectionChanged="PresetSelected">
          <arc:RadioGroup.ItemTemplate>
            <DataTemplate x:DataType="frontend:HostPresetItem">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{arc:ArcDesignTokenResource Space4}">
                <StackPanel Spacing="{arc:ArcDesignTokenResource Space1}" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Definition.Name}" Foreground="{arc:ArcDesignTokenResource Foreground}"/>
                  <TextBlock Text="{Binding Definition.Map}" Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                             FontSize="{arc:ArcDesignTokenResource TypeXS}"/>
                </StackPanel>
                <arc:PresenceHost Grid.Column="1" Mode="Fade" IsPresent="{Binding Selected}"
                                  VerticalAlignment="Center">
                  <arc:Badge Size="Small" Tone="Success" Content="启动预设"/>
                </arc:PresenceHost>
              </Grid>
            </DataTemplate>
          </arc:RadioGroup.ItemTemplate>
        </arc:RadioGroup>
        <StackPanel x:Name="PresetActions" IsVisible="False" Spacing="{arc:ArcDesignTokenResource Space4}">
          <StackPanel Spacing="{arc:ArcDesignTokenResource Space2}">
            <TextBlock x:Name="PresetActionsTitle" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <WrapPanel ItemSpacing="{arc:ArcDesignTokenResource Space2}" LineSpacing="{arc:ArcDesignTokenResource Space2}">
              <arc:Button x:Name="ManageButton" Content="查看配置" Variant="Secondary" Size="Medium" Click="ManagePreset"/>
              <arc:Button x:Name="EditButton" Content="编辑基本信息" Variant="Secondary" Size="Medium" Click="EditPreset"/>
              <arc:Button x:Name="CopyButton" Content="复制预设" Variant="Secondary" Size="Medium" Click="CopyPreset"/>
              <arc:Button x:Name="SelectButton" Content="设为启动预设" Variant="Secondary" Size="Medium" Click="SelectPreset"/>
            </WrapPanel>
          </StackPanel>
          <StackPanel Spacing="{arc:ArcDesignTokenResource Space2}">
            <TextBlock Text="CFG 与文件" FontWeight="SemiBold"/>
            <WrapPanel ItemSpacing="{arc:ArcDesignTokenResource Space2}" LineSpacing="{arc:ArcDesignTokenResource Space2}">
              <arc:Button x:Name="CfgButton" Content="CFG 管理" Variant="Secondary" Size="Medium" Click="EditCfg"/>
              <arc:Button x:Name="OpenCfgButton" Content="打开 CFG 目录" Variant="Secondary" Size="Medium" Click="OpenCfg"/>
              <arc:Button x:Name="OpenAddonsButton" Content="打开 addons 目录" Variant="Secondary" Size="Medium" Click="OpenAddons"/>
            </WrapPanel>
          </StackPanel>
          <arc:HoldToConfirm x:Name="DeleteButton" Label="长按删除预设" ConfirmedLabel="正在删除…"
                             HorizontalAlignment="Left" HoldDuration="0:0:1" Tone="Danger" Confirmed="DeletePreset"/>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Border>
</UserControl>
