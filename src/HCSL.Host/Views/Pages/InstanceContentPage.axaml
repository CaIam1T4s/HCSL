<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc" xmlns:lucide="using:TKCode.Arc.Icons.Lucide"
             x:Class="HCSL.Host.Views.Pages.InstanceContentPage" x:CompileBindings="False">
  <ScrollViewer Margin="{DynamicResource ConsolePageInset}" HorizontalScrollBarVisibility="Disabled">
    <ItemsControl x:Name="Frameworks" AutomationProperties.Name="框架列表">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <arc:Button Variant="Ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                      MinHeight="{arc:ArcDesignTokenResource ControlSizeMD}" Click="OpenFramework"
                      AutomationProperties.Name="{Binding Name}">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="{arc:ArcDesignTokenResource Space3}">
              <lucide:LucideIcon Kind="Layers" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="2" Text="{Binding State}" VerticalAlignment="Center"
                         Foreground="{arc:ArcDesignTokenResource TextSecondary}"/>
              <lucide:LucideIcon Grid.Column="3" Kind="ArrowRight" VerticalAlignment="Center"/>
            </Grid>
          </arc:Button>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </ScrollViewer>
</UserControl>
