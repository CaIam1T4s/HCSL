<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc" xmlns:lucide="using:TKCode.Arc.Icons.Lucide"
             xmlns:pages="using:HCSL.Host.Views.Pages"
             x:Class="HCSL.Host.Views.Pages.InstanceContentPage" x:CompileBindings="False">
  <ScrollViewer Margin="{DynamicResource ConsolePageInset}" HorizontalScrollBarVisibility="Disabled">
    <ItemsControl x:Name="Frameworks" AutomationProperties.Name="框架列表">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="pages:InstanceContentPage+Row" x:CompileBindings="True">
          <Border BorderThickness="0,0,0,1" BorderBrush="{arc:ArcDesignTokenResource Border}"
                  MinHeight="{arc:ArcDesignTokenResource Space12}">
            <Grid>
              <arc:Button Variant="Ghost" CornerRadius="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Click="OpenFramework" AutomationProperties.Name="{Binding Name}"/>
              <Grid IsHitTestVisible="False" Margin="{DynamicResource ConsolePageInset}"
                    ColumnDefinitions="Auto,2*,3*,Auto" ColumnSpacing="{arc:ArcDesignTokenResource Space3}">
                <lucide:LucideIcon Kind="Layers" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="2" Text="{Binding State}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{arc:ArcDesignTokenResource TextSecondary}"/>
                <lucide:LucideIcon Grid.Column="3" Kind="ArrowRight" VerticalAlignment="Center"/>
              </Grid>
              <arc:Button Variant="Ghost" Size="Small" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Margin="0,0,42,0" IsVisible="{Binding CanDisable}" Click="DisableFramework"
                          AutomationProperties.Name="停用框架">
                <lucide:LucideIcon Kind="X"/>
              </arc:Button>
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </ScrollViewer>
</UserControl>
