<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:lucide="using:TKCode.Arc.Icons.Lucide"
             xmlns:vm="using:HCSL.Host.ViewModels"
             x:Class="HCSL.Host.Views.Pages.InstanceMapPoolsPage"
             x:CompileBindings="False" Classes="instance-pools-page">
  <Grid RowDefinitions="Auto,*" RowSpacing="{arc:ArcDesignTokenResource Space4}" Margin="{DynamicResource ConsolePageInset}">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{arc:ArcDesignTokenResource Space3}">
      <arc:Tabs x:Name="ManagementTabs" ContentMargin="0" SelectedIndex="0" VerticalAlignment="Center">
        <arc:TabItem x:Name="PoolTab" Header="图池管理"/>
        <arc:TabItem x:Name="MapsTab" Header="地图管理"/>
      </arc:Tabs>
      <arc:Button x:Name="CreateButton" Grid.Column="1" Variant="Secondary" Click="CreatePool"
                  IsVisible="{Binding #PoolTab.IsSelected}" VerticalAlignment="Center" AutomationProperties.Name="新建图池">
        <StackPanel Orientation="Horizontal" Spacing="{arc:ArcDesignTokenResource Space2}">
          <lucide:LucideIcon Kind="Plus" VerticalAlignment="Center"/>
          <TextBlock Text="新建图池" VerticalAlignment="Center"/>
        </StackPanel>
      </arc:Button>
    </Grid>
    <Grid Grid.Row="1" IsVisible="{Binding #PoolTab.IsSelected}">
      <arc:Table x:Name="PoolChoices" Caption="图池列表" IsSelectable="False"
                 EmptyMessage="暂无图池" LoadingMessage="正在读取图池">
        <arc:Table.Columns>
          <arc:DataTableColumn Header="图池名" Binding="{Binding Name}" Width="*" IsSortable="False"/>
          <arc:DataTableColumn Header="地图数量" Width="112" IsSortable="False">
            <arc:DataTableColumn.CellTemplate>
              <DataTemplate x:DataType="vm:MapPoolRow">
                <arc:Badge Content="{Binding Count}" Tone="{Binding Tone}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
              </DataTemplate>
            </arc:DataTableColumn.CellTemplate>
          </arc:DataTableColumn>
          <arc:DataTableColumn Header="预设引用" Binding="{Binding Presets}" Width="180" IsSortable="False">
            <arc:DataTableColumn.CellTemplate>
              <DataTemplate x:DataType="vm:MapPoolRow">
                <TextBlock Text="{Binding Presets}" Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
              </DataTemplate>
            </arc:DataTableColumn.CellTemplate>
          </arc:DataTableColumn>
          <arc:DataTableColumn Header="轮换" Binding="{Binding RotationText}" Width="120" IsSortable="False">
            <arc:DataTableColumn.CellTemplate>
              <DataTemplate x:DataType="vm:MapPoolRow">
                <TextBlock Text="{Binding RotationText}" Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
              </DataTemplate>
            </arc:DataTableColumn.CellTemplate>
          </arc:DataTableColumn>
          <arc:DataTableColumn Header="操作" Width="72" IsSortable="False">
            <arc:DataTableColumn.CellTemplate>
              <DataTemplate x:DataType="vm:MapPoolRow">
                <arc:Button Classes="pool-row-action" Content="⋯" Variant="Ghost" Size="Small" Click="OpenPoolActions"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            AutomationProperties.Name="{Binding Name, StringFormat='操作图池：{0}'}"/>
              </DataTemplate>
            </arc:DataTableColumn.CellTemplate>
          </arc:DataTableColumn>
        </arc:Table.Columns>
      </arc:Table>
      <Canvas x:Name="PoolMenuLayer" IsHitTestVisible="False">
        <Border x:Name="PoolMenuAnchor" Width="1" Height="1"/>
      </Canvas>
      <arc:Popover x:Name="DeletePopover" Placement="Bottom" Alignment="End" Offset="0" TriggerMode="Manual" HasShadow="False">
        <arc:Popover.Styles>
          <Style Selector="arc|PopoverSurface">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
          </Style>
        </arc:Popover.Styles>
        <arc:HoldToConfirm x:Name="DeleteButton" Label="长按删除图池" ConfirmedLabel="正在删除…"
                           HoldDuration="0:0:1" Tone="Danger" Confirmed="DeletePool"/>
      </arc:Popover>
    </Grid>
    <ContentControl x:Name="MapsHost" Grid.Row="1" IsVisible="{Binding #MapsTab.IsSelected}"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
  </Grid>
</UserControl>
