<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:HCSL.Host.ViewModels" xmlns:controls="using:HCSL.UI.Shared.Controls" xmlns:arc="https://github.com/AIDotNet/TKCode.Arc" x:Class="HCSL.Host.Views.Pages.SettingsPage" x:DataType="vm:ShellViewModel">
  <ScrollViewer>
    <StackPanel Margin="36" Spacing="22">
      <TextBlock Classes="heading" Text="设置"/>
      <TextBlock Classes="muted" Text="外观、下载和服务端维护。"/>
      <Border Classes="panel">
        <StackPanel Spacing="12">
          <TextBlock Classes="subheading" Text="外观主题"/>
          <TextBlock Classes="muted" Text="浅色、深色与跟随系统同时适用于页面和 Arc 控件。"/>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <arc:Button Content="跟随系统" Classes.selected="{Binding IsSystemTheme}" Command="{Binding SetThemeCommand}" CommandParameter="跟随系统" Variant="Secondary"/>
            <arc:Button Content="浅色" Classes.selected="{Binding IsLightTheme}" Command="{Binding SetThemeCommand}" CommandParameter="浅色" Variant="Secondary"/>
            <arc:Button Content="深色" Classes.selected="{Binding IsDarkTheme}" Command="{Binding SetThemeCommand}" CommandParameter="深色" Variant="Secondary"/>
          </StackPanel>
          <TextBlock Classes="muted" Text="主题偏好仅在当前会话生效。"/>
        </StackPanel>
      </Border>
      <Border Classes="panel">
        <StackPanel Spacing="12">
          <TextBlock Classes="subheading" Text="窗口背景"/>
          <TextBlock Classes="muted" Text="选择本地 PNG 或 JPEG 作为标题栏、侧栏和所有主页面的统一背景；未选择图片时，所有页面使用同一套随主题变化的默认渐变。自定义图片仅本次会话生效。"/>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <arc:Button Content="选择图片" Click="ChooseBackground" Variant="Secondary"/>
            <arc:Button Content="恢复默认" Click="ResetBackground" Variant="Secondary"/>
          </StackPanel>
          <TextBlock x:Name="BackgroundStatus" Classes="muted" Text="当前使用默认背景"/>
          <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
            <TextBlock Text="背景显示强度" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="{Binding BackgroundOpacityLabel}" Classes="muted"/>
          </Grid>
          <arc:Slider Minimum="0" Maximum="100" Value="{Binding BackgroundOpacityPercent, Mode=TwoWay}" AutomationProperties.Name="背景显示强度，百分比"/>
          <TextBlock Classes="muted" Text="0% 为主题底色，100% 为完整背景。这不是窗口透明度，不会透出桌面。设置仅本次会话生效。" FontSize="{arc:ArcDesignTokenResource TypeXS}"/>
        </StackPanel>
      </Border>
      <Border Classes="panel">
        <StackPanel Spacing="12">
          <TextBlock Classes="subheading" Text="标题栏与侧栏磨砂玻璃"/>
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="着色不透明度"/>
            <TextBlock Grid.Column="1" Text="{Binding SidebarTintLabel}" Classes="muted"/>
          </Grid>
          <arc:Slider Minimum="0" Maximum="100" Value="{Binding SidebarTintPercent, Mode=TwoWay}" AutomationProperties.Name="标题栏与侧栏着色不透明度，百分比"/>
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="模糊强度"/>
            <TextBlock Grid.Column="1" Text="{Binding SidebarBlurLabel}" Classes="muted"/>
          </Grid>
          <arc:Slider Minimum="0" Maximum="32" Value="{Binding SidebarBlurRadius, Mode=TwoWay}" AutomationProperties.Name="标题栏与侧栏模糊半径"/>
          <TextBlock Classes="muted" FontSize="{arc:ArcDesignTokenResource TypeXS}" Text="使用 Arc 磨砂玻璃，仅处理应用内背景，文字与图标保持清晰。照片背景更容易看出模糊；着色 100% 时遮住背景，显示强度 0% 时只有纯色，模糊差异不明显。"/>
        </StackPanel>
      </Border>
      <Border Classes="panel">
        <StackPanel Spacing="12">
          <TextBlock Classes="subheading" Text="关于此版本"/>
          <TextBlock x:Name="VersionText" Text="{Binding VersionLabel}" AutomationProperties.Name="当前版本"/>
          <TextBlock Classes="muted" Text="开发预览 · 仅提供界面骨架。Steam 登录、建服、插件和组网尚未接入。"/>
        </StackPanel>
      </Border>
      <Border x:Name="DownloadSettingsSection" Classes="panel">
        <StackPanel Classes="instance-editor" Spacing="12">
          <TextBlock Classes="subheading" Text="下载"/>
          <TextBlock Text="{Binding SteamCmd.ConnectionText}" Classes="muted"/>
          <StackPanel Spacing="8" IsEnabled="{Binding SteamCmd.CanEdit}">
            <TextBlock Text="内容库"/>
            <controls:ElevatedSurface><arc:Input Label="内容库" IsLabelVisible="False" Text="{Binding SteamCmd.LibraryRoot, Mode=TwoWay}"/></controls:ElevatedSurface>
            <TextBlock Text="SteamCMD 路径"/>
            <controls:ElevatedSurface><arc:Input Label="SteamCMD 路径" IsLabelVisible="False" Text="{Binding SteamCmd.ExecutablePath, Mode=TwoWay}" PlaceholderText="留空使用受管工具"/></controls:ElevatedSurface>
            <TextBlock Text="登录超时（秒）"/>
            <controls:ElevatedSurface><arc:Input Label="登录超时（秒）" IsLabelVisible="False" Text="{Binding SteamCmd.TimeoutSeconds, Mode=TwoWay}"/></controls:ElevatedSurface>
            <TextBlock Text="安装超时（秒）"/>
            <controls:ElevatedSurface><arc:Input Label="安装超时（秒）" IsLabelVisible="False" Text="{Binding SteamCmd.InstallTimeoutSeconds, Mode=TwoWay}"/></controls:ElevatedSurface>
            <arc:Checkbox Content="自动准备缺失的 SteamCMD" IsChecked="{Binding SteamCmd.InstallIfMissing, Mode=TwoWay}"/>
          </StackPanel>
          <arc:Button Content="恢复下载任务" Click="RecoverDownload" IsEnabled="{Binding SteamCmd.CanStart}" Variant="Ghost" HorizontalAlignment="Left"/>
          <TextBlock Classes="subheading" Text="启动基线（部署校验记录）" Margin="0,12,0,0"/>
          <TextBlock Text="用于部署前核对当前内容库中的服务端文件。校验记录异常不会改变服务端的安装状态。" Classes="muted" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding Baseline.StatusText}" Classes="muted" TextWrapping="Wrap"/>
          <WrapPanel>
            <arc:Button Content="检查状态" Click="CheckBaseline" IsEnabled="{Binding Baseline.CanRefresh}" Variant="Ghost"/>
            <arc:Button Content="校验并重建" Click="RebuildBaseline" IsEnabled="{Binding Baseline.CanRefresh}" Variant="Secondary"/>
          </WrapPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
