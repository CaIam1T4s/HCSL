<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:vm="using:HCSL.Host.ViewModels"
             xmlns:controls="using:HCSL.UI.Shared.Controls"
             x:Class="HCSL.Host.Views.Pages.DownloadsPage" x:DataType="vm:ShellViewModel">
  <UserControl.Styles>
    <Style Selector="arc|Button">
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Size" Value="Small"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="MinHeight" Value="32"/>
    </Style>
    <Style Selector="arc|Button[Variant=Primary]">
      <Setter Property="Background" Value="{arc:ArcDesignTokenResource Accent}"/>
      <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource AccentForeground}"/>
    </Style>
    <Style Selector="arc|Button.resource-row"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
  </UserControl.Styles>
  <Grid Margin="32" RowDefinitions="Auto,*" RowSpacing="12">
    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
      <TextBlock Classes="heading" Text="下载中心" VerticalAlignment="Center"/>
      <controls:ElevatedSurface Grid.Column="1"><arc:Button Content="刷新" Variant="Ghost" Click="RefreshResources"/></controls:ElevatedSurface>
      <controls:ElevatedSurface Grid.Column="2"><arc:Button Content="下载设置" Variant="Ghost" Click="OpenSettings"/></controls:ElevatedSurface>
    </Grid>
    <StackPanel Grid.Row="1" Spacing="8">
      <TextBlock Text="服务端" Classes="section"/>
      <controls:ElevatedSurface>
        <arc:Button x:Name="ServerResource" Classes="resource-row" Variant="Ghost" Click="OpenServer" Height="56" Padding="0" BorderThickness="0"
                    HorizontalContentAlignment="Stretch" IsPressScaleEnabled="False">
          <!-- Arc's animated content host sizes to its child; give that child the full row width explicitly. -->
          <Grid Width="{Binding #ServerResource.Bounds.Width}" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
            <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Server}" Size="24" Margin="16,0,0,0" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center" HorizontalAlignment="Left">
              <TextBlock Text="CS2 服务端"/>
              <TextBlock x:Name="ServerVersion" Text="-" Classes="muted" FontSize="{arc:ArcDesignTokenResource TypeXS}"/>
            </StackPanel>
            <arc:Badge Grid.Column="2" Content="更新可用" IsVisible="{Binding SteamCmd.ContentUpdateAvailable}" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="3" Text="›" Margin="0,0,16,0" HorizontalAlignment="Right" VerticalAlignment="Center"/>
          </Grid>
        </arc:Button>
      </controls:ElevatedSurface>
      <TextBlock Text="框架" Classes="section"/>
      <TextBlock Text="框架在线版本目录与下载源尚未接入。" Classes="muted" TextWrapping="Wrap"/>
    </StackPanel>
    <arc:Dialog x:Name="ServerDialog" Title="CS2 服务端" Description="由 SteamCMD 获取当前发布版本。下载不会自动启动服务器。">
      <StackPanel Spacing="12">
        <TextBlock Text="安装位置"/>
        <TextBlock Text="{Binding SteamCmd.ServerDirectory}" TextWrapping="Wrap" Classes="muted"/>
      </StackPanel>
      <arc:Dialog.Actions>
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
          <arc:Button Content="校验" Variant="Secondary" Click="ValidateServer" IsEnabled="{Binding SteamCmd.CanStart}"/>
          <arc:Button x:Name="InstallButton" Content="更新" Variant="Primary" Click="InstallServer" IsEnabled="{Binding SteamCmd.CanStart}"/>
        </StackPanel>
      </arc:Dialog.Actions>
    </arc:Dialog>
    <arc:Dialog x:Name="DownloadDialog" Title="下载 CS2 服务端" ShowHeader="False" ShowCloseButton="False"
                CloseOnEscape="False" CloseOnOutsidePress="False" Size="Large">
      <StackPanel Spacing="12">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock x:Name="TaskTitle" Text="下载 CS2 服务端" Classes="subheading"/>
          <TextBlock x:Name="Elapsed" Grid.Column="1" Text="00:00" VerticalAlignment="Center"/>
        </Grid>
        <arc:Stepper x:Name="TaskSteps" Orientation="Vertical" IsNavigable="False" Label="下载阶段"/>
        <Grid Height="40">
          <arc:Progress x:Name="TaskProgress" Maximum="100" IsValueVisible="True" IsVisible="False" VerticalAlignment="Bottom"/>
          <Canvas x:Name="UnknownProgressTrack" Height="16" VerticalAlignment="Bottom" ClipToBounds="True" IsHitTestVisible="False">
            <arc:Skeleton x:Name="UnknownProgress" Lines="1" IsLoading="True" Label="当前阶段进度不可用"/>
          </Canvas>
        </Grid>
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
          <TextBlock Text="-" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="1" Text="- / -" VerticalAlignment="Center"/>
          <controls:ElevatedSurface Grid.Column="2" Height="32"><arc:Button x:Name="CancelButton" Content="取消" Variant="Ghost" Click="CancelProbe"/></controls:ElevatedSurface>
        </Grid>
      </StackPanel>
    </arc:Dialog>
  </Grid>
</UserControl>
