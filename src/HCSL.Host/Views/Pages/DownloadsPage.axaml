<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:lucide="using:TKCode.Arc.Icons.Lucide"
             xmlns:vm="using:HCSL.Host.ViewModels"
             xmlns:controls="using:HCSL.UI.Shared.Controls"
             xmlns:ui="using:HCSL.UI.Shared.Services"
             x:Class="HCSL.Host.Views.Pages.DownloadsPage" x:DataType="vm:ShellViewModel">
  <UserControl.Styles>
    <Style Selector="arc|Button">
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Size" Value="Small"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="MinHeight" Value="32"/>
    </Style>
    <Style Selector="arc|Button[Variant=Primary]">
      <Setter Property="Background" Value="{arc:ArcDesignTokenResource Accent}"/>
      <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource AccentForeground}"/>
    </Style>
    <!-- The icon-only back button matches the InstancesPage back affordance instead of the compact
         toolbar sizing used by every other button on this page. -->
    <Style Selector="arc|Button.catalog-back">
      <Setter Property="Size" Value="Medium"/>
      <Setter Property="Height" Value="44"/>
      <Setter Property="MinHeight" Value="44"/>
    </Style>
    <Style Selector="arc|Button.resource-row">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <!-- Same surface fill as the instance rows: a solid window-derived panel colour instead of the
           transparent ghost background that let the wallpaper gradient show through. -->
      <Setter Property="Background" Value="{ReflectionBinding $parent[Window].Background, Converter={x:Static ui:SurfaceBrushConverter.Instance}, ConverterParameter=0.78}"/>
    </Style>
    <!-- Match InstancesPage expanding button group hover/focus styles -->
    <Style Selector="arc|ExpandingButtonGroup.downloads-actions /template/ Panel">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="arc|ExpandingButtonGroup.downloads-actions /template/ Border#PART_Pill">
      <Setter Property="HorizontalAlignment" Value="Right"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="ui:CenteredShadow.Source" Value="{arc:ArcDesignTokenResource ShadowRaised}"/>
    </Style>
    <Style Selector="arc|ExpandingButtonGroup.downloads-actions arc|ExpandingButtonGroupItem:pointerover:not(:unavailable) /template/ Border#PART_Body">
      <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}"/>
    </Style>
    <Style Selector="arc|ExpandingButtonGroup.downloads-actions:focus-within /template/ Border#PART_Pill">
      <Setter Property="ui:CenteredShadow.Source" Value="{arc:ArcDesignTokenResource ShadowFloating}"/>
    </Style>
  </UserControl.Styles>
  <Grid Margin="32" RowDefinitions="Auto,*" RowSpacing="12">
    <Grid ColumnDefinitions="Auto,*,Auto">
      <controls:ElevatedSurface x:Name="CatalogBack" VerticalAlignment="Center" Margin="0,0,8,0" IsVisible="False">
        <arc:Button x:Name="CatalogBackButton" Classes="catalog-back" Variant="Ghost" Click="CloseFrameworkCatalog"
                    AutomationProperties.Name="返回下载中心">
          <lucide:LucideIcon Kind="ArrowLeft"/>
        </arc:Button>
      </controls:ElevatedSurface>
      <TextBlock x:Name="DownloadsHeading" Grid.Column="1" Classes="heading" Text="下载中心" VerticalAlignment="Center"/>
      <Grid Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Width="{arc:ArcDesignTokenResource MediaSizeXL}">
        <arc:ExpandingButtonGroup x:Name="ToolbarActions" Classes="launch-actions downloads-actions" Label="下载中心操作" HorizontalAlignment="Stretch" ClipToBounds="False">
          <arc:ExpandingButtonGroupItem x:Name="RefreshButton" Label="刷新" Click="RefreshResources"/>
          <arc:ExpandingButtonGroupItem x:Name="SettingsButton" Label="下载设置" Click="OpenSettings"/>
        </arc:ExpandingButtonGroup>
      </Grid>
    </Grid>
    <StackPanel x:Name="ResourceList" Grid.Row="1" Spacing="8">
      <TextBlock Text="服务端" Classes="section"/>
      <controls:ElevatedSurface>
        <arc:Button x:Name="ServerResource" Classes="resource-row" Variant="Ghost" Click="OpenServer" Height="56" Padding="0" BorderThickness="0"
                    HorizontalContentAlignment="Stretch" IsPressScaleEnabled="False">
          <!-- Arc's animated content host sizes to its child; give that child the full row width explicitly. -->
          <Grid Width="{Binding #ServerResource.Bounds.Width}" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
            <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Server}" Size="24" Margin="16,0,0,0" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center" HorizontalAlignment="Left">
              <TextBlock Text="CS2 服务端"/>
              <TextBlock x:Name="ServerVersion" Text="-" Classes="muted" FontSize="{arc:ArcDesignTokenResource TypeXS}"/>
            </StackPanel>
            <arc:Badge Grid.Column="2" Content="更新可用" IsVisible="{Binding SteamCmd.ContentUpdateAvailable}" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="3" Text="›" Margin="0,0,16,0" HorizontalAlignment="Right" VerticalAlignment="Center"/>
          </Grid>
        </arc:Button>
      </controls:ElevatedSurface>
      <TextBlock Text="框架" Classes="section"/>
      <StackPanel x:Name="FrameworkRows" Spacing="8"/>
    </StackPanel>
    <Grid x:Name="FrameworkCatalogPanel" Grid.Row="1" RowDefinitions="Auto,*" RowSpacing="8" IsVisible="False">
      <TextBlock x:Name="CatalogStatus" Classes="muted" TextWrapping="Wrap"/>
      <ScrollViewer x:Name="VersionScroll" Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <arc:SkeletonMorph x:Name="VersionsLoading" IsLoading="True" Stagger="0:0:0.05" LoadingLabel="读取框架版本目录">
          <StackPanel x:Name="VersionRows" Margin="0,0,12,0"/>
        </arc:SkeletonMorph>
      </ScrollViewer>
      <controls:ElevatedSurface x:Name="LoadMoreSurface" Grid.Row="1" HorizontalAlignment="Center" Margin="0,8,0,0" VerticalAlignment="Bottom" IsVisible="False">
        <arc:Button x:Name="LoadMoreButton" Click="LoadMoreButton_Click" Variant="Ghost" IsEnabled="True">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Panel Width="18" Height="18">
              <arc:ArcGlyph x:Name="LoadMoreGlyph" Data="{x:Static arc:ArcIcons.RefreshCw}" Size="16" IsVisible="True"/>
              <arc:MorphLoader x:Name="LoadMoreLoader" Size="18" Variant="Dots" IsDecorative="True" IsVisible="False"/>
            </Panel>
            <TextBlock x:Name="LoadMoreLabel" Text="加载更多" VerticalAlignment="Center"/>
          </StackPanel>
          <arc:Button.Transitions>
            <Transitions>
              <arc:ArcDoubleTransition Property="Opacity" Tween="Standard"/>
            </Transitions>
          </arc:Button.Transitions>
        </arc:Button>
      </controls:ElevatedSurface>
    </Grid>
    <arc:Dialog x:Name="ServerDialog" Title="CS2 服务端" Description="由 SteamCMD 获取当前发布版本。下载不会自动启动服务器。">
      <StackPanel Spacing="12">
        <TextBlock Text="安装位置"/>
        <TextBlock Text="{Binding SteamCmd.ServerDirectory}" TextWrapping="Wrap" Classes="muted"/>
      </StackPanel>
      <arc:Dialog.Actions>
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
          <arc:Button Content="校验" Variant="Secondary" Click="ValidateServer" IsEnabled="{Binding SteamCmd.CanStart}"/>
          <arc:Button x:Name="InstallButton" Content="更新" Variant="Primary" Click="InstallServer" IsEnabled="{Binding SteamCmd.CanStart}"/>
        </StackPanel>
      </arc:Dialog.Actions>
    </arc:Dialog>
    <arc:Dialog x:Name="DownloadDialog" Title="下载 CS2 服务端" ShowHeader="False" ShowCloseButton="False"
                CloseOnEscape="False" CloseOnOutsidePress="False" Size="Large">
      <StackPanel Spacing="12">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock x:Name="TaskTitle" Text="下载 CS2 服务端" Classes="subheading"/>
          <TextBlock x:Name="Elapsed" Grid.Column="1" Text="00:00" VerticalAlignment="Center"/>
        </Grid>
        <arc:Stepper x:Name="TaskSteps" Orientation="Vertical" IsNavigable="False" Label="下载阶段"/>
        <Grid Height="40">
          <arc:SkeletonMorph x:Name="ProgressRegion" IsLoading="True" Stagger="0:0:0" LoadingLabel="当前阶段进度不可用"
                             Background="Transparent" VerticalAlignment="Bottom">
            <arc:MorphBlock SkeletonHeight="4" SkeletonRadius="2">
              <arc:Progress x:Name="TaskProgress" Maximum="100" IsValueVisible="True"/>
            </arc:MorphBlock>
          </arc:SkeletonMorph>
        </Grid>
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
          <TextBlock Text="-" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="1" Text="- / -" VerticalAlignment="Center"/>
          <controls:ElevatedSurface Grid.Column="2" Height="32"><arc:Button x:Name="CancelButton" Content="取消" Variant="Ghost" Click="CancelProbe"/></controls:ElevatedSurface>
        </Grid>
      </StackPanel>
    </arc:Dialog>
  </Grid>
</UserControl>
