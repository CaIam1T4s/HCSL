<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:HCSL.Host.Views.Controls"
             x:Class="HCSL.Host.Views.Controls.BackgroundScene"
             x:Name="SceneRoot" x:DataType="local:BackgroundScene"
             IsHitTestVisible="False" ClipToBounds="True">
  <Grid Background="{DynamicResource ShellBackground}">
    <Grid Opacity="{Binding #SceneRoot.Strength}">
      <local:DefaultBackground/>
      <Image Source="{Binding #SceneRoot.ImageSource}" Stretch="UniformToFill"/>
      <Border Background="{DynamicResource BackgroundScrim}"/>
    </Grid>
  </Grid>
</UserControl>
