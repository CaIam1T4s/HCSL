<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:lucide="using:TKCode.Arc.Icons.Lucide"
             xmlns:vm="using:HCSL.Host.ViewModels"
             xmlns:views="using:HCSL.Host.Views"
             x:Class="HCSL.Host.Views.MapsPage"
             x:DataType="vm:MapRow">
  <UserControl.Resources>
    <!-- One row at a time: a compact dot whose fill and ring animate through Arc's tokens and motion levels. -->
    <ControlTheme x:Key="MapSelectRadio" TargetType="RadioButton">
      <!-- No padding or margin of its own: the dot must sit exactly in the middle of the ring. -->
      <Setter Property="Width" Value="14"/>
      <Setter Property="Height" Value="14"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <ControlTemplate>
          <!-- Two ellipses: a stroke is centred on its own bounds, so no border inset can move the dot. -->
          <Grid Width="14" Height="14" Background="Transparent">
            <Ellipse Name="Ring" Width="14" Height="14" StrokeThickness="1"
                     Stroke="{arc:ArcDesignTokenResource BorderStrong}"/>
            <Ellipse Name="Dot" Width="6" Height="6"
                     Fill="{arc:ArcDesignTokenResource Accent}"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     arc:ArcMotion.Tracks="True" Opacity="0"/>
          </Grid>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:checked /template/ Ellipse#Dot">
        <Setter Property="Opacity" Value="1"/>
      </Style>
      <Style Selector="^:checked /template/ Ellipse#Ring">
        <Setter Property="Stroke" Value="{arc:ArcDesignTokenResource Accent}"/>
      </Style>
      <Style Selector="^:pointerover /template/ Ellipse#Ring">
        <Setter Property="Stroke" Value="{arc:ArcDesignTokenResource AccentStrong}"/>
      </Style>
      <Style Selector="^:checked:pointerover /template/ Ellipse#Ring">
        <Setter Property="Stroke" Value="{arc:ArcDesignTokenResource Accent}"/>
      </Style>
      <Style Selector="^/template/ Ellipse#Dot:motion-full">
        <Setter Property="Transitions">
          <Transitions><arc:ArcDoubleTransition Property="Opacity" Tween="Standard"/></Transitions>
        </Setter>
      </Style>
      <Style Selector="^/template/ Ellipse#Dot:motion-reduced">
        <Setter Property="Transitions">
          <Transitions><arc:ArcDoubleTransition Property="Opacity" Tween="Instant"/></Transitions>
        </Setter>
      </Style>
    </ControlTheme>
    <DataTemplate x:Key="MapSelectCell" x:DataType="vm:MapRow">
      <RadioButton Theme="{StaticResource MapSelectRadio}" GroupName="map-selection"
                   IsChecked="{Binding IsSelected, Mode=TwoWay}"
                   HorizontalAlignment="Left" VerticalAlignment="Center"/>
    </DataTemplate>
    <DataTemplate x:Key="MapSourceCell" x:DataType="vm:MapRow">
      <arc:Badge Size="Small" Tone="{Binding SourceTone}" Content="{Binding SourceText}"
                 HorizontalAlignment="Left" VerticalAlignment="Center"/>
    </DataTemplate>
    <DataTemplate x:Key="MapPoolsCell" x:DataType="vm:MapRow">
      <arc:PresenceStack ItemsSource="{Binding Pools}" Label="所属图池" IsCountVisible="False"
                         Size="Small" MaxVisibleCount="3" VerticalAlignment="Center"/>
    </DataTemplate>
  </UserControl.Resources>

  <Border Padding="{DynamicResource ConsolePageInset}">
  <Grid RowDefinitions="Auto,Auto,*" RowSpacing="{arc:ArcDesignTokenResource Space3}">
    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto">
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{arc:ArcDesignTokenResource Space1}">
        <arc:Button x:Name="RulesButton" Variant="Ghost" Size="Small" Click="ShowRules">
          <lucide:LucideIcon Kind="CircleQuestionMark"/>
        </arc:Button>
        <arc:Button x:Name="RefreshButton" Variant="Ghost" Size="Small" Click="Refresh">
          <lucide:LucideIcon Kind="RotateCw"/>
        </arc:Button>
      </StackPanel>
    </Grid>

    <arc:FilterToolbar Grid.Row="1" x:Name="Filters" IsSearchVisible="True"
                       SearchPlaceholder="搜索地图名或工坊 ID" Label="地图筛选"
                       EmptyText="没有已应用的筛选" AddFilterLabel="筛选" ClearAllLabel="清除筛选"
                       FiltersChanged="FiltersChanged">
      <arc:FilterToolbar.Fields>
        <arc:FilterField Id="source" Label="来源">
          <arc:FilterField.Options>
            <arc:FilterOption Value="standard" Label="内置"/>
            <arc:FilterOption Value="preview" Label="预览"/>
            <arc:FilterOption Value="workshop" Label="工坊"/>
            <arc:FilterOption Value="missing" Label="未下载"/>
          </arc:FilterField.Options>
        </arc:FilterField>
        <arc:FilterField Id="pool" Label="图池"/>
      </arc:FilterToolbar.Fields>
    </arc:FilterToolbar>

    <arc:SelectionToolbar Grid.Row="2" x:Name="Selection" HorizontalAlignment="Stretch"
                          SelectAllRequested="SelectAll" Cleared="ClearSelection" ActionInvoked="Invoked">
      <arc:SelectionToolbar.Actions>
        <arc:SelectionToolbarAction Key="switch" Label="切换到该图"/>
      </arc:SelectionToolbar.Actions>
      <arc:Table x:Name="Table" IsSelectable="False" Caption="地图目录"
                 EmptyMessage="没有符合条件的地图" LoadingMessage="正在读取地图目录"
                 ItemNameOne="张地图" ItemNameOther="张地图">
        <arc:Table.Columns>
          <arc:DataTableColumn Header="" IsSortable="False" Width="36" CellTemplate="{StaticResource MapSelectCell}"/>
          <arc:DataTableColumn Header="地图名" Binding="{Binding Name}" Width="340"/>
          <arc:DataTableColumn Header="来源" Binding="{Binding SourceText}" IsSortable="False" Width="120"
                               CellTemplate="{StaticResource MapSourceCell}"/>
          <arc:DataTableColumn Header="所属图池" Binding="{Binding PoolText}" IsSortable="False" Width="180"
                               CellTemplate="{StaticResource MapPoolsCell}"/>
        </arc:Table.Columns>
      </arc:Table>
    </arc:SelectionToolbar>
  </Grid>
  </Border>
</UserControl>
