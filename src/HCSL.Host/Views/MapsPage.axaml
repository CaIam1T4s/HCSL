<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:lucide="using:TKCode.Arc.Icons.Lucide"
             xmlns:vm="using:HCSL.Host.ViewModels"
             xmlns:views="using:HCSL.Host.Views"
             x:Class="HCSL.Host.Views.MapsPage"
             x:Name="Root"
             x:DataType="vm:MapRow">

  <Border Classes.catalog-frame="True" Classes.embedded="{ReflectionBinding #Root.ManagePools}">
    <Border.Styles>
      <Style Selector="Border.catalog-frame">
        <Setter Property="Padding" Value="{DynamicResource ConsolePageInset}"/>
      </Style>
      <Style Selector="Border.catalog-frame.embedded">
        <Setter Property="Padding" Value="0"/>
      </Style>
    </Border.Styles>
  <Grid RowDefinitions="Auto,*" RowSpacing="{arc:ArcDesignTokenResource Space3}">
    <arc:FilterToolbar x:Name="Filters" IsSearchVisible="True"
                       SearchPlaceholder="搜索地图名或工坊 ID" Label="地图筛选"
                       EmptyText="没有已应用的筛选" AddFilterLabel="筛选" ClearAllLabel="清除筛选"
                       Classes.embedded="{ReflectionBinding #Root.ManagePools}" FiltersChanged="FiltersChanged">
      <arc:FilterToolbar.Styles>
        <Style Selector="arc|FilterToolbar.embedded /template/ ContentPresenter#PART_ExtraActions">
          <Setter Property="IsVisible" Value="False"/>
        </Style>
      </arc:FilterToolbar.Styles>
      <arc:FilterToolbar.Actions>
        <StackPanel x:Name="CatalogActions" IsVisible="{ReflectionBinding !#Root.ManagePools}" Orientation="Horizontal" Spacing="{arc:ArcDesignTokenResource Space1}">
          <!-- Icon-only actions use a 28 px target with no padding of their own, so they sit as close as the
               toolbar's own controls instead of widening the row. -->
          <arc:Button x:Name="RulesButton" Variant="Ghost" Size="Small" Click="ShowRules"
                      Width="{arc:ArcDesignTokenResource Space6}" Height="{arc:ArcDesignTokenResource Space6}"
                      Padding="0">
            <lucide:LucideIcon Kind="CircleQuestionMark"/>
          </arc:Button>
          <arc:Button x:Name="RefreshButton" Variant="Ghost" Size="Small" Click="Refresh"
                      Width="{arc:ArcDesignTokenResource Space6}" Height="{arc:ArcDesignTokenResource Space6}"
                      Padding="0">
            <lucide:LucideIcon Kind="RotateCw"/>
          </arc:Button>
        </StackPanel>
      </arc:FilterToolbar.Actions>
      <arc:FilterToolbar.Fields>
        <arc:FilterField Id="source" Label="来源">
          <arc:FilterField.Options>
            <arc:FilterOption Value="standard" Label="内置"/>
            <arc:FilterOption Value="preview" Label="预览"/>
            <arc:FilterOption Value="workshop" Label="工坊"/>
            <arc:FilterOption Value="missing" Label="未下载"/>
          </arc:FilterField.Options>
        </arc:FilterField>
        <arc:FilterField Id="pool" Label="图池"/>
      </arc:FilterToolbar.Fields>
    </arc:FilterToolbar>

    <arc:SelectionToolbar Grid.Row="1" x:Name="Selection" HorizontalAlignment="Stretch"
                          SelectAllRequested="SelectAll" Cleared="ClearSelection" ActionInvoked="Invoked">
      <arc:SelectionToolbar.Styles>
        <Style Selector="arc|Button:not(:disabled)">
          <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}"/>
        </Style>
        <Style Selector="arc|Button:disabled /template/ Border#PART_Frame">
          <Setter Property="Background" Value="Transparent"/>
          <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
      </arc:SelectionToolbar.Styles>
      <arc:SelectionToolbar.Actions>
        <arc:SelectionToolbarAction Key="switch" Label="切换到该图"/>
      </arc:SelectionToolbar.Actions>
      <arc:TreeTable x:Name="CollectionTree" Caption="地图目录"/>
    </arc:SelectionToolbar>
    <arc:Popover x:Name="RemoveWorkshopPopover" Grid.Row="1" Placement="Top" Offset="0" TriggerMode="Manual" HasShadow="False">
      <arc:Popover.Styles>
        <Style Selector="arc|PopoverSurface">
          <Setter Property="Background" Value="Transparent"/>
          <Setter Property="Padding" Value="0"/>
          <Setter Property="BorderThickness" Value="0"/>
        </Style>
      </arc:Popover.Styles>
      <arc:HoldToConfirm x:Name="RemoveWorkshopConfirm" Label="长按移除地图" ConfirmedLabel="正在移除…"
                         HoldDuration="0:0:1" Tone="Danger" Confirmed="ConfirmRemoveWorkshop"/>
    </arc:Popover>
  </Grid>
  </Border>
</UserControl>
