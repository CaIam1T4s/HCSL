<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:lucide="using:TKCode.Arc.Icons.Lucide"
             xmlns:vm="using:HCSL.Host.ViewModels"
             xmlns:views="using:HCSL.Host.Views"
             x:Class="HCSL.Host.Views.MapsPage"
             x:DataType="vm:MapRow">
  <UserControl.Resources>
    <!-- Selection reads as a table row: an accent rail on the left and a check on the right. Arc's PresenceHost owns
         the motion (fade for the rail, a pop for the check), so motion levels and reduced motion are handled for us. -->
    <DataTemplate x:Key="MapRailCell" x:DataType="vm:MapRow">
      <arc:PresenceHost Mode="Fade" IsPresent="{Binding IsSelected}" Margin="6,0,0,0">
        <Border Width="3" CornerRadius="{arc:ArcDesignTokenResource RadiusPill}"
                Background="{arc:ArcDesignTokenResource Accent}"/>
      </arc:PresenceHost>
    </DataTemplate>
    <DataTemplate x:Key="MapSelectedCell" x:DataType="vm:MapRow">
      <!-- Kept clear of the scrollbar's lane; the pop starts small so it reads as a state change. -->
      <arc:PresenceHost Mode="Pop" EnterScale="0.6" IsPresent="{Binding IsSelected}"
                        HorizontalAlignment="Right" Margin="0,0,16,0" IsHitTestVisible="False">
        <lucide:LucideIcon Kind="Check" Width="16" Height="16"
                           Foreground="{arc:ArcDesignTokenResource Accent}"/>
      </arc:PresenceHost>
    </DataTemplate>
    <DataTemplate x:Key="MapSourceCell" x:DataType="vm:MapRow">
      <arc:Badge Size="Small" Tone="{Binding SourceTone}" Content="{Binding SourceText}"
                 HorizontalAlignment="Left" VerticalAlignment="Center"/>
    </DataTemplate>
    <DataTemplate x:Key="MapPoolsCell" x:DataType="vm:MapRow">
      <arc:PresenceStack ItemsSource="{Binding Pools}" Label="所属图池" IsCountVisible="False"
                         Size="Small" MaxVisibleCount="3" VerticalAlignment="Center"/>
    </DataTemplate>
  </UserControl.Resources>

  <Border Padding="{DynamicResource ConsolePageInset}">
  <Grid RowDefinitions="Auto,*" RowSpacing="{arc:ArcDesignTokenResource Space3}">
    <arc:FilterToolbar x:Name="Filters" IsSearchVisible="True"
                       SearchPlaceholder="搜索地图名或工坊 ID" Label="地图筛选"
                       EmptyText="没有已应用的筛选" AddFilterLabel="筛选" ClearAllLabel="清除筛选"
                       FiltersChanged="FiltersChanged">
      <arc:FilterToolbar.Actions>
        <StackPanel Orientation="Horizontal" Spacing="{arc:ArcDesignTokenResource Space1}">
          <!-- Icon-only actions use a 28 px target with no padding of their own, so they sit as close as the
               toolbar's own controls instead of widening the row. -->
          <arc:Button x:Name="RulesButton" Variant="Ghost" Size="Small" Click="ShowRules"
                      Width="{arc:ArcDesignTokenResource Space6}" Height="{arc:ArcDesignTokenResource Space6}"
                      Padding="0">
            <lucide:LucideIcon Kind="CircleQuestionMark"/>
          </arc:Button>
          <arc:Button x:Name="RefreshButton" Variant="Ghost" Size="Small" Click="Refresh"
                      Width="{arc:ArcDesignTokenResource Space6}" Height="{arc:ArcDesignTokenResource Space6}"
                      Padding="0">
            <lucide:LucideIcon Kind="RotateCw"/>
          </arc:Button>
        </StackPanel>
      </arc:FilterToolbar.Actions>
      <arc:FilterToolbar.Fields>
        <arc:FilterField Id="source" Label="来源">
          <arc:FilterField.Options>
            <arc:FilterOption Value="standard" Label="内置"/>
            <arc:FilterOption Value="preview" Label="预览"/>
            <arc:FilterOption Value="workshop" Label="工坊"/>
            <arc:FilterOption Value="missing" Label="未下载"/>
          </arc:FilterField.Options>
        </arc:FilterField>
        <arc:FilterField Id="pool" Label="图池"/>
      </arc:FilterToolbar.Fields>
    </arc:FilterToolbar>

    <arc:SelectionToolbar Grid.Row="1" x:Name="Selection" HorizontalAlignment="Stretch"
                          SelectAllRequested="SelectAll" Cleared="ClearSelection" ActionInvoked="Invoked">
      <arc:SelectionToolbar.Actions>
        <arc:SelectionToolbarAction Key="switch" Label="切换到该图"/>
      </arc:SelectionToolbar.Actions>
      <arc:Table x:Name="Table" IsSelectable="False" Caption="地图目录"
                 EmptyMessage="没有符合条件的地图" LoadingMessage="正在读取地图目录"
                 ItemNameOne="张地图" ItemNameOther="张地图">
        <arc:Table.Columns>
          <arc:DataTableColumn Header="" IsSortable="False" Width="16" CellTemplate="{StaticResource MapRailCell}"/>
          <arc:DataTableColumn Header="地图名" Binding="{Binding Name}" Width="340"/>
          <arc:DataTableColumn Header="来源" Binding="{Binding SourceText}" IsSortable="False" Width="120"
                               CellTemplate="{StaticResource MapSourceCell}"/>
          <arc:DataTableColumn Header="所属图池" Binding="{Binding PoolText}" IsSortable="False" Width="180"
                               CellTemplate="{StaticResource MapPoolsCell}"/>
          <arc:DataTableColumn Header="" IsSortable="False" Width="*" CellTemplate="{StaticResource MapSelectedCell}"/>
        </arc:Table.Columns>
      </arc:Table>
    </arc:SelectionToolbar>
  </Grid>
  </Border>
</UserControl>
