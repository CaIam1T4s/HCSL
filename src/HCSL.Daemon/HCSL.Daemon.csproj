  <PropertyGroup Condition="'$(BundledDaemonAot)' == 'true'">
    <PublishAot>true</PublishAot>
  </PropertyGroup>
  <PropertyGroup Condition="'$(PublishAot)' == 'true'">
    <DefineConstants>$(DefineConstants);HCSL_DAEMON_NATIVE_AOT</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="HCSL.IpcTests" />
    <ProjectReference Include="../HCSL.Contracts/HCSL.Contracts.csproj" />
    <ProjectReference Include="../HCSL.Infrastructure/HCSL.Infrastructure.csproj" />
  </ItemGroup>
</Project>
