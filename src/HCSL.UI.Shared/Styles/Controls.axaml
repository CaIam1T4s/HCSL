<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
        xmlns:ui="using:HCSL.UI.Shared.Services"
        xmlns:controls="clr-namespace:HCSL.UI.Shared.Controls;assembly=HCSL.UI.Shared">
  <!-- Keep Arc's title-bar and overlay template parts, but place one scene behind both rows. -->
  <Style Selector="arc|ArcWindow.wallpaper-shell">
    <Setter Property="Template">
      <ControlTemplate TargetType="arc:ArcWindow" x:CompileBindings="False">
        <Panel>
          <Border Name="PART_TransparencyFallback" IsHitTestVisible="False"/>
          <Border Name="PART_Root" Background="{TemplateBinding Background}">
            <Grid>
              <controls:BackgroundScene Name="PART_WindowBackdrop"
                  ImageSource="{Binding (controls:WindowBackdrop.ImageSource), RelativeSource={RelativeSource TemplatedParent}}"
                  Strength="{Binding (controls:WindowBackdrop.Strength), RelativeSource={RelativeSource TemplatedParent}}"/>
              <controls:LShapedFrostedChrome Name="PART_ShellChrome" Source="{Binding #PART_WindowBackdrop}"
                  TitleBarHeight="{Binding #PART_TitleBarPresenter.Bounds.Height}"
                  IsTitleBarVisible="{TemplateBinding IsTitleBarVisible}"/>
              <VisualLayerManager Name="PART_VisualLayerManager" EnableOverlayLayer="True">
                <Grid RowDefinitions="Auto,*">
                  <Grid ZIndex="1" IsVisible="{TemplateBinding IsTitleBarVisible}">
                    <ContentPresenter Name="PART_TitleBarPresenter" Content="{TemplateBinding TitleBar}"/>
                  </Grid>
                  <ContentPresenter Name="PART_ContentPresenter" Grid.Row="1" Margin="{TemplateBinding Padding}"
                                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
                </Grid>
              </VisualLayerManager>
            </Grid>
          </Border>
          <!-- The modal plane is outside the layer manager: its scrim covers title chrome, menus, popovers and toasts. -->
          <ContentPresenter Name="PART_ModalPresenter" ZIndex="1"
                            IsVisible="{Binding (controls:WindowModalLayer.IsOpen), RelativeSource={RelativeSource TemplatedParent}}"
                            Content="{Binding (controls:WindowModalLayer.Content), RelativeSource={RelativeSource TemplatedParent}}"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
        </Panel>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="arc|Dialog">
    <Setter Property="BackdropBlur" Value="{arc:ArcDesignTokenResource BackdropBlurDialog}"/>
  </Style>
  <Style Selector="arc|ArcWindow.wallpaper-shell.modal-open /template/ Border#PART_Root">
    <Setter Property="Effect"><BlurEffect Radius="{arc:ArcDesignTokenResource BackdropBlurDialog}"/></Setter>
  </Style>
  <Style Selector="arc|ArcWindow.player-shell.modal-open Grid.modal-background, arc|ArcWindow.player-shell.modal-open arc|TitleBar">
    <Setter Property="Effect"><BlurEffect Radius="{arc:ArcDesignTokenResource BackdropBlurDialog}"/></Setter>
  </Style>
  <Style Selector="arc|ArcWindow.wallpaper-shell arc|TitleBar">
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style Selector="arc|ArcWindow.wallpaper-shell .main-sidebar /template/ Border#PART_FooterSeparator">
    <Setter Property="Opacity" Value="0"/>
  </Style>
  <Style Selector="arc|ArcWindow.wallpaper-shell arc|ThemeSwitcher /template/ arc|Button#PART_Button">
    <Setter Property="Background" Value="{ReflectionBinding $parent[Window].Background, Converter={x:Static ui:SurfaceBrushConverter.Instance}, ConverterParameter=0.7}"/>
  </Style>
  <Style Selector="arc|ArcWindow.wallpaper-shell arc|ExpandingButtonGroup.launch-actions">
    <Setter Property="Background" Value="{ReflectionBinding $parent[Window].Background, Converter={x:Static ui:SurfaceBrushConverter.Instance}, ConverterParameter=0.72}"/>
  </Style>
  <!-- Tint the template surface, not the action's spring/brush-transition source property. -->
  <Style Selector="arc|ArcWindow.wallpaper-shell arc|ExpandingButtonGroup.launch-actions arc|ExpandingButtonGroupItem:expanded /template/ Border#PART_Body">
    <Setter Property="Background" Value="{ReflectionBinding $parent[Window].Background, Converter={x:Static ui:SurfaceBrushConverter.Instance}, ConverterParameter=0.55}"/>
  </Style>
  <Style Selector="arc|ArcWindow.wallpaper-shell arc|Popover.launch-configuration arc|PopoverSurface">
    <Setter Property="Background" Value="{DynamicResource FloatingSurfaceBackground}"/>
  </Style>
  <Style Selector="TextBlock.instance-subtitle">
    <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}"/>
    <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeXS}"/>
  </Style>
  <!-- Right-aligned read-only value of a property row; shared by the instance pages. -->
  <Style Selector="TextBlock.instance-property-value">
    <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}"/>
    <Setter Property="HorizontalAlignment" Value="Right"/>
    <Setter Property="TextAlignment" Value="Right"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style Selector="Window">
    <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}"/>
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style Selector="TextBlock.section">
    <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextMuted}"/>
    <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeXS}"/>
    <Setter Property="Margin" Value="12,18,0,8"/>
  </Style>
  <Style Selector="TextBlock.heading">
    <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource Type2XL}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style Selector="TextBlock.page-title">
    <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource Type2XL}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style Selector="TextBlock.subheading">
    <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeLG}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}"/>
    <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusPanel}"/>
    <Setter Property="Padding" Value="24"/>
  </Style>
  <Style Selector="Border.notice">
    <Setter Property="Background" Value="{arc:ArcDesignTokenResource AccentSubtle}"/>
    <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusControl}"/>
    <Setter Property="Padding" Value="14"/>
  </Style>
  <Style Selector="Border.launch-shadow">
    <Setter Property="BoxShadow" Value="{arc:ArcDesignTokenResource ShadowRaised}"/>
    <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}"/>
    <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusPill}"/>
  </Style>
  <Style Selector="Border.avatar">
    <Setter Property="Width" Value="34"/>
    <Setter Property="Height" Value="34"/>
    <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusControl}"/>
    <Setter Property="Background" Value="{arc:ArcDesignTokenResource AccentSubtle}"/>
  </Style>
  <Style Selector="Border.sidebar">
    <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}"/>
    <Setter Property="BorderThickness" Value="0,0,1,0"/>
  </Style>
  <Style Selector="arc|ArcWindow.wallpaper-shell Border.sidebar">
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style Selector="arc|Button">
    <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusPill}"/>
  </Style>
  <Style Selector="arc|Button[Variant=Secondary]:not(.nav):not(.empty-launch)">
    <Setter Property="Size" Value="Small"/>
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="Height" Value="32"/>
  </Style>
  <Style Selector="arc|Button.compact">
    <Setter Property="Size" Value="Small"/>
    <Setter Property="MinHeight" Value="30"/>
    <Setter Property="Height" Value="30"/>
  </Style>
  <Style Selector="arc|Button.nav">
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="MinHeight" Value="42"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}"/>
    <Setter Property="FontWeight" Value="Normal"/>
  </Style>
  <Style Selector="arc|Button.nav:pointerover">
    <Setter Property="Background" Value="{arc:ArcDesignTokenResource AccentSubtle}"/>
  </Style>
  <Style Selector="arc|Button.nav.selected">
    <Setter Property="Background" Value="{arc:ArcDesignTokenResource AccentSubtle}"/>
    <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource AccentStrong}"/>
  </Style>
  <Style Selector="arc|Button.nav.selected Path.glyph">
    <Setter Property="Stroke" Value="{arc:ArcDesignTokenResource AccentStrong}"/>
  </Style>
  <Style Selector="arc|Button:disabled">
    <Setter Property="Opacity" Value="1"/>
    <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}"/>
    <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}"/>
    <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}"/>
  </Style>
  <Style Selector="arc|Button.selected">
    <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Accent}"/>
  </Style>
  <Style Selector="arc|Button.empty-launch">
    <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}"/>
    <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}"/>
    <Setter Property="MinHeight" Value="68"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
  </Style>
  <Style Selector="arc|Button.empty-launch:pointerover">
    <Setter Property="Background" Value="{arc:ArcDesignTokenResource AccentSubtle}"/>
  </Style>
  <Style Selector="Path.glyph">
    <Setter Property="Width" Value="16"/>
    <Setter Property="Height" Value="16"/>
    <Setter Property="Stretch" Value="Uniform"/>
    <Setter Property="Stroke" Value="{arc:ArcDesignTokenResource Foreground}"/>
    <Setter Property="StrokeThickness" Value="1.8"/>
  </Style>
  <!-- Shared Arc field/selection formats. Page code owns layout, not templates. -->
  <Style Selector="arc|Input, arc|PasswordField, arc|Textarea">
    <Setter Property="ui:InputPointerPlacement.Enabled" Value="True"/>
  </Style>
  <Style Selector="arc|Input, arc|PasswordField">
    <Setter Property="MinHeight" Value="36"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
  </Style>
  <Style Selector="arc|Textarea">
    <Setter Property="MinHeight" Value="90"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
  </Style>
  <Style Selector="arc|Textarea.task-log">
    <Setter Property="Height" Value="220"/>
    <Setter Property="FrameHeight" Value="220"/>
    <Setter Property="IsResizable" Value="False"/>
    <Setter Property="ClipToBounds" Value="True"/>
  </Style>
  <Style Selector="arc|Textarea.task-log /template/ ScrollViewer">
    <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
  </Style>
  <Style Selector="arc|Textarea.server-log /template/ ScrollViewer">
    <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
    <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
  </Style>
  <!-- The console log is a flat surface: no field frame, no radius, no border.
       FieldFrame is the element that paints the frame; its properties are Template-bound into PART_Border. -->
  <Style Selector="arc|Textarea.console-log /template/ arc|FieldFrame">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="0"/>
  </Style>
  <Style Selector="arc|Textarea.console-log">
    <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeSM}"/>
    <!-- The log sits on its own gradient, so the command-echo bands below it stay visible. -->
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <!-- Console player table: the page frame draws the only outline, so both template borders go away.
       Template parts need the /template/ selector; a style on the control alone does not reach them. -->
  <Style Selector="arc|Table.console-players /template/ Border#PART_Frame">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="0"/>
  </Style>
  <Style Selector="arc|Table.console-players /template/ Border#PART_Outline">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="0"/>
  </Style>
  <Style Selector="Border.console-placeholder">
    <Setter Property="Padding" Value="{DynamicResource PanelPadding}"/>
  </Style>
  <!-- Share dialog body: Arc's header is fixed, so the body carries the rhythm instead. -->
  <Style Selector="StackPanel.share-body">
    <Setter Property="Spacing" Value="{arc:ArcDesignTokenResource Space3}"/>
    <Setter Property="Margin" Value="{DynamicResource DialogBodyInset}"/>
  </Style>
  <!-- The console action group shows one label at rest; it must not read as hovered until pointed at. -->
  <Style Selector="arc|ExpandingButtonGroup.console-actions">
    <Setter Property="ClipToBounds" Value="False"/>
  </Style>
  <Style Selector="arc|ExpandingButtonGroup.console-actions /template/ Panel">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="ClipToBounds" Value="False"/>
  </Style>
  <Style Selector="arc|ExpandingButtonGroup.console-actions /template/ Border#PART_Pill">
    <Setter Property="HorizontalAlignment" Value="Right"/>
    <Setter Property="BorderThickness" Value="0"/>
    <!-- The pill floats over the log, so it carries Arc's elevation token, not a hand-written shadow. -->
    <Setter Property="ui:CenteredShadow.Source" Value="{arc:ArcDesignTokenResource ShadowRaised}"/>
  </Style>
  <Style Selector="arc|ExpandingButtonGroup.console-actions:focus-within /template/ Border#PART_Pill">
    <Setter Property="ui:CenteredShadow.Source" Value="{arc:ArcDesignTokenResource ShadowFloating}"/>
  </Style>
  <Style Selector="arc|ExpandingButtonGroup.console-actions arc|ExpandingButtonGroupItem:expanded:not(:pointerover) /template/ Border#PART_Body">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="arc|ExpandingButtonGroup.console-actions arc|ExpandingButtonGroupItem:pointerover:not(:unavailable) /template/ Border#PART_Body">
    <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}"/>
  </Style>
  <Style Selector="arc|Select">
    <Setter Property="MinHeight" Value="36"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
  </Style>
  <Style Selector="arc|Checkbox">
    <Setter Property="MinHeight" Value="32"/>
  </Style>
  <Style Selector="Border.dialog-overlay">
    <Setter Property="Background" Value="{arc:ArcDesignTokenResource Scrim}"/>
  </Style>
  <!-- Only the material is translucent. Foregrounds, shadow layers and modal scrims retain their own opacity. -->
  <Style Selector="arc|DialogSurface, arc|DrawerSurface, arc|PopoverSurface, arc|MenuSurface, arc|Toast, arc|Tooltip">
    <Setter Property="Background" Value="{DynamicResource FloatingSurfaceBackground}"/>
  </Style>
  <!-- The bubble inherits its text colour from the placement target (a badge, a button); pin it to the theme. -->
  <Style Selector="arc|Tooltip">
    <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}"/>
  </Style>
  <Style Selector=".elevated-surface Border.surface-shadow">
    <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusPill}"/>
    <Setter Property="arc:ArcMotion.Tracks" Value="True"/>
    <Setter Property="ui:CenteredShadow.Source" Value="{arc:ArcDesignTokenResource ShadowRaised}"/>
  </Style>
  <Style Selector=".elevated-surface Border.surface-active-shadow">
    <Setter Property="ui:CenteredShadow.Source" Value="{arc:ArcDesignTokenResource ShadowFloating}"/>
  </Style>
  <Style Selector=".elevated-surface:focus-within Border.surface-resting-shadow">
    <Setter Property="Opacity" Value="0"/>
  </Style>
  <Style Selector=".elevated-surface:focus-within Border.surface-active-shadow">
    <Setter Property="Opacity" Value="1"/>
  </Style>
  <Style Selector=".elevated-surface Border.surface-shadow:motion-full">
    <Setter Property="Transitions"><Transitions><arc:ArcDoubleTransition Property="Opacity" Tween="Standard"/></Transitions></Setter>
  </Style>
  <Style Selector=".elevated-surface Border.surface-shadow:motion-reduced">
    <Setter Property="Transitions"><Transitions><arc:ArcDoubleTransition Property="Opacity" Tween="Instant"/></Transitions></Setter>
  </Style>
  <Style Selector="StackPanel.instance-editor">
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="Spacing" Value="{arc:ArcDesignTokenResource Space3}"/>
  </Style>
  <Style Selector="StackPanel.instance-editor arc|Input /template/ arc|FieldFrame#PART_Frame">
    <Setter Property="Background" Value="{ReflectionBinding $parent[Window].Background, Converter={x:Static ui:SurfaceBrushConverter.Instance}, ConverterParameter=0.72}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
  </Style>
  <Style Selector="StackPanel.instance-editor arc|Button">
    <Setter Property="Size" Value="Small"/>
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="Height" Value="32"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
  </Style>
  <Style Selector="StackPanel.instance-editor arc|Button[Variant=Secondary]">
    <Setter Property="Background" Value="{ReflectionBinding $parent[Window].Background, Converter={x:Static ui:SurfaceBrushConverter.Instance}, ConverterParameter=0.72}"/>
  </Style>
  <Style Selector="StackPanel.instance-editor arc|Button.instance-save">
    <Setter Property="Background" Value="{arc:ArcDesignTokenResource Accent}"/>
    <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource AccentForeground}"/>
  </Style>
  <Style Selector="Border.instance-editor-divider">
    <!-- EdgeThickness is a Thickness token, not a scalar Height. -->
    <Setter Property="Height" Value="1"/>
    <Setter Property="Background" Value="{arc:ArcDesignTokenResource Border}"/>
  </Style>
  <Style Selector="arc|ArcWindow.download-error">
    <Setter Property="Background" Value="{DynamicResource FloatingSurfaceBackground}"/>
  </Style>
  <Style Selector="arc|ArcWindow.download-error arc|Button">
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Size" Value="Small"/>
    <Setter Property="Height" Value="32"/>
    <Setter Property="MinHeight" Value="32"/>
  </Style>
  <Style Selector="arc|ArcWindow.download-error arc|Button[Variant=Primary]">
    <Setter Property="Background" Value="{arc:ArcDesignTokenResource Accent}"/>
    <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource AccentForeground}"/>
  </Style>
  <!-- Console pages inset their content from the window edges and keep the window's own gradient. -->
  <Style Selector="Border.console-page">
    <Setter Property="Padding" Value="{DynamicResource ConsolePageInset}"/>
  </Style>
  <!-- The outer frame owns the stroke; the table's own frame and outline stay invisible (see .console-players). -->
  <Style Selector="Border.console-roster-frame">
    <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}"/>
    <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}"/>
    <Setter Property="BorderThickness" Value="{DynamicResource ConsoleFrameThickness}"/>
    <Setter Property="Padding" Value="{DynamicResource ConsoleFrameThickness}"/>
    <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusSurface}"/>
    <Setter Property="ClipToBounds" Value="True"/>
  </Style>
  <!-- The scroller is clipped to the same rounded shape, so a sorted column's tint cannot square the corners. -->
  <Style Selector="Border.console-roster-clip">
    <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusSurface}"/>
    <Setter Property="ClipToBounds" Value="True"/>
  </Style>
  <!-- Console search sits on the log gradient like the instance list's search sits on its page. -->
  <Style Selector="Grid.console-search arc|SearchField /template/ arc|FieldFrame#PART_Frame">
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}"/>
  </Style>
  <Style Selector="Grid.console-search arc|SearchField /template/ arc|FieldFrame#PART_Frame:pointerover:not(:invalid)">
    <Setter Property="BorderBrush" Value="Transparent"/>
  </Style>
  <Style Selector="Grid.console-search arc|SearchField /template/ arc|FieldFrame#PART_Frame:focus-active:not(:invalid)">
    <Setter Property="BorderBrush" Value="Transparent"/>
  </Style>
  <!-- Invisible square the popovers anchor to, placed at the context menu's origin. -->
  <Style Selector="Border.popover-anchor">
    <Setter Property="Width" Value="{arc:ArcDesignTokenResource Space1}"/>
    <Setter Property="Height" Value="{arc:ArcDesignTokenResource Space1}"/>
  </Style>
  <!-- Both footer buttons take the same Arc size, so their heights line up and neither is sized ad hoc. -->
  <Style Selector="StackPanel.dialog-actions arc|Button">
    <Setter Property="Size" Value="Small"/>
  </Style>
  <!-- HCSL pills float on Arc's elevation (ShadowRaised) instead of a drawn stroke. -->
  <Style Selector="StackPanel.dialog-actions arc|Button /template/ Border#PART_Frame">
    <Setter Property="BoxShadow" Value="{arc:ArcDesignTokenResource ShadowRaised}"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <!-- Arc's Primary variant is the foreground fill; HCSL's one considered action carries the accent. -->
  <Style Selector="arc|Button.dialog-primary">
    <Setter Property="Background" Value="{arc:ArcDesignTokenResource Accent}"/>
    <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource AccentForeground}"/>
  </Style>
  <Style Selector="Border.dialog-surface">
    <Setter Property="Background" Value="{DynamicResource FloatingSurfaceBackground}"/>
    <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusSurface}"/>
    <Setter Property="BoxShadow" Value="{arc:ArcDesignTokenResource ShadowFloating}"/>
  </Style>
</Styles>
